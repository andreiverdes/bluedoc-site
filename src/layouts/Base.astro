---
import '../styles/global.css';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistMonoLatin from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import geistPixelLatin from '@fontsource/geist-pixel/files/geist-pixel-latin-400-normal.woff2?url';
import { meta } from '../content/site';
import { base } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
}

const { title = meta.title, description = meta.description } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}og.png`, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#05070f" />
    <meta name="color-scheme" content="dark light" />

    <script is:inline>
      // Before first paint: the theme (a saved pick wins, otherwise dark), .js, and .motion when the reader allows
      // motion, which is what lets src/scripts/motion.ts start elements hidden and animate them in.
      (function () {
        var t = 'dark';
        try {
          t = localStorage.getItem('bd-site-theme') || 'dark';
        } catch (e) {}
        var d = document.documentElement;
        d.dataset.theme = t === 'light' ? 'light' : 'dark';
        d.classList.add('js');
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('motion');
      })();
    </script>

    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMonoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistPixelLatin} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="32x32" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="bluedoc" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={meta.ogImageAlt} />
  </head>
  <body>
    <a href="#main" class="sr-only-focusable btn btn-primary fixed top-3 left-3 z-[100]">Skip to content</a>
    <slot />
    <script>
      import '../scripts/site';
      import '../scripts/motion';
    </script>
  </body>
</html>
