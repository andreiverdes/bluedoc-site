---
// One doc type's showcase page, from one entry of src/content/types.ts, as ruled rows: the hero with its clip
// (01–02), What it's for (03), the feature rows (04), the shared clips in a band (05), How the agent uses it
// (06), the install row (07) and the other types (08). Only the hero clip loads early; every other clip waits for
// the reader to scroll to it.
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Row from '../components/Row.astro';
import SectionHead from '../components/SectionHead.astro';
import TypeHero from '../components/TypeHero.astro';
import ClipCard from '../components/ClipCard.astro';
import FeatureRow from '../components/FeatureRow.astro';
import AgentSnippet from '../components/AgentSnippet.astro';
import Install from '../components/Install.astro';
import TypeLinks from '../components/TypeLinks.astro';
import { docTypes, nav } from '../content/site';
import { typePageLabels as labels, type TypePageCopy } from '../content/types';
import { inlineCode } from '../lib/inline-code';

interface Props {
  page: TypePageCopy;
}

const { page } = Astro.props;
const docType = docTypes.items.find((t) => t.id === page.type);
const cols = page.kinds.length <= 4 ? page.kinds.length : Math.ceil(page.kinds.length / 2);
---

<Base title={page.metaTitle} description={page.metaDescription}>
  <Nav />
  <main id="main">
    <TypeHero kicker="Doc type" display={page.display} title={page.title} pitch={page.pitch} hero={page.hero} tag={docType?.tag} />

    <Row n="03" labelledby="for-title">
      <SectionHead kicker={labels.forKicker} title={page.forTitle} titleId="for-title" lead={page.forLead} />
      <ul class="kinds" style={`--cols:${cols}`}>
        {
          page.kinds.map((k, i) => (
            <li class="kind" data-reveal={String(i % 4)}>
              <span class="pill">{k.label}</span>
              <p class="mt-4 text-[0.9375rem] text-fg-muted">{k.body}</p>
            </li>
          ))
        }
      </ul>
    </Row>

    <Row n="04" labelledby="features-title">
      <SectionHead kicker={labels.featuresKicker} title={labels.featuresTitle} titleId="features-title" />
      {page.features.map((item, i) => <FeatureRow item={item} index={i} />)}
    </Row>

    <Row n="05" band labelledby="shared-title">
      <SectionHead kicker={labels.sharedKicker} title={labels.sharedTitle} titleId="shared-title">
        <a class="link-arrow" href={nav.typesMenu.features.href}>
          {labels.sharedLink}
          <ArrowUpRight class="size-4" aria-hidden="true" />
        </a>
      </SectionHead>
      <ul class:list={['clip-grid', { 'clip-grid-3': page.shared.length % 3 === 0 }]}>
        {page.shared.map((item, i) => <ClipCard item={item} index={i % 3} />)}
      </ul>
    </Row>

    <Row n="06" labelledby="agent-title">
      <SectionHead kicker={labels.agentKicker} title={labels.agentTitle} titleId="agent-title" leadHtml={inlineCode(page.agent.lead)} />
      <div class="rail-pad row-y pt-0!" data-reveal>
        <AgentSnippet agent={page.agent} />
      </div>
    </Row>

    <Install n="07" />
    <TypeLinks n="08" current={page.type} />
  </main>
  <Footer />
</Base>

<style>
  .kinds {
    display: grid;
    border-top: 1px solid var(--rail);
  }
  @media (min-width: 640px) {
    .kinds {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .kinds {
      grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    }
  }
  .kind {
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    border-right: 1px solid var(--rail);
    border-bottom: 1px solid var(--rail);
    margin-bottom: -1px;
  }
</style>
