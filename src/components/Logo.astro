  '<path d="M1 19.5L10.4 27V48H6.2C3.3 48 1 45.7 1 42.8Z" fill="#0438a8" opacity=".45"/><path d="M23.4 0Q25 0 26.4 1.3L42.1 15H28.6Q24.8 15 24.8 11.2V1.4Q24.4 0 23.4 0Z" fill="#5ab4ff"/>' +
  '<g fill="#1e88ff"><rect x="14.2" y="20.6" width="14.2" height="2.5" rx="1.25"/><rect x="14.2" y="25.7" width="14.2" height="2.5" rx="1.25"/><rect x="14.2" y="30.6" width="8.6" height="2.5" rx="1.25"/></g>';

const WORDMARK =
  '<path class="b" d="M39 1.1Q35.4 1.1 32.1 0.1Q28.8-0.9 26.2-2.6Q24-4 22.4-5.8L22-0.1L7.1-0.1L7.1-74L23.2-74L23.2-47.6Q24.6-49.2 26.5-50.5Q29.1-52.2 32.2-53.2Q35.3-54.2 38.6-54.2Q45.5-54.2 50.9-50.7Q56.2-47.1 59.3-40.9Q62.4-34.6 62.4-26.6Q62.4-18.5 59.4-12.3Q56.3-6 51-2.5Q45.7 1.1 39 1.1ZM34.8-12.4Q38.4-12.4 41.1-14.2Q43.8-16 45.3-19.2Q46.7-22.3 46.7-26.6Q46.7-30.8 45.3-34Q43.8-37.2 41.1-38.9Q38.4-40.6 34.8-40.6Q31.1-40.6 28.4-38.9Q25.7-37.2 24.2-34Q22.7-30.8 22.7-26.6Q22.7-22.3 24.2-19.2Q25.7-16 28.4-14.2Q31.1-12.4 34.8-12.4ZM89 0L73 0L73-74L89-74L89 0ZM120.9 1.1Q115 1.1 110.9-1.5Q106.7-4 104.5-8.8Q102.2-13.6 102.2-20.3L102.2-53.1L118.3-53.1L118.3-22.5Q118.3-19.3 119.3-17Q120.3-14.7 122.3-13.5Q124.3-12.2 127.1-12.2Q129.2-12.2 130.9-12.9Q132.7-13.6 133.9-14.9Q135.2-16.1 135.9-17.8Q136.6-19.4 136.6-21.4L136.6-53.1L152.7-53.1L152.7 0L137.6 0L137.2-6.8Q136.6-6.1 135.9-5.4Q133.1-2.4 129.2-0.7Q125.3 1.1 120.9 1.1ZM192.3 1Q183.5 1 177-2.6Q170.5-6.1 166.9-12.3Q163.3-18.4 163.3-26.3Q163.3-32.4 165.3-37.5Q167.3-42.6 170.9-46.4Q174.5-50.1 179.5-52.2Q184.4-54.2 190.3-54.2Q195.9-54.2 200.6-52.2Q205.2-50.2 208.6-46.6Q212-43 213.8-38.1Q215.6-33.2 215.4-27.4L215.3-23.1L178.8-23.1Q179.3-21.4 180.2-19.9Q182-16.6 185.6-14.8Q189.1-13 194-13Q197.4-13 200.1-14Q202.7-15 205.8-17.4L213.3-6.8Q210.2-4.1 206.7-2.4Q203.2-0.7 199.6 0.2Q195.9 1 192.3 1ZM178.8-32.1L200.6-32.1L200.6-32.2Q200.4-34.7 199.1-36.6Q197.7-38.6 195.5-39.7Q193.3-40.8 190.5-40.8Q186.6-40.8 183.9-39.3Q181.1-37.7 179.7-34.8Q179.1-33.5 178.8-32.1Z"/>' +
  '<path class="d" d="M245.7 1.1Q238.8 1.1 233.4-2.5Q228.1-6 225-12.3Q221.9-18.5 221.9-26.5Q221.9-34.5 225-40.8Q228.1-47 233.5-50.6Q238.9-54.2 245.9-54.2Q249.5-54.2 252.8-53.1Q256.1-52 258.8-50.1Q260.2-49.1 261.4-47.9L261.4-74L277.5-74L277.5 0L262.6 0L262.2-5.8Q260.7-4.1 258.7-2.8Q256.1-1 252.8 0.1Q249.4 1.1 245.7 1.1ZM249.8-12.2Q253.5-12.2 256.2-14Q258.9-15.8 260.4-19Q261.8-22.2 261.8-26.5Q261.8-30.9 260.4-34.1Q258.9-37.3 256.2-39.1Q253.5-40.9 249.8-40.9Q246.1-40.9 243.4-39.1Q240.8-37.3 239.3-34.1Q237.8-30.9 237.8-26.5Q237.8-22.2 239.3-19Q240.8-15.8 243.4-14Q246.1-12.2 249.8-12.2ZM316 1Q307.7 1 301.3-2.6Q294.8-6.2 291-12.4Q287.3-18.6 287.3-26.6Q287.3-34.6 291-40.8Q294.8-47 301.3-50.6Q307.7-54.2 316-54.2Q324.3-54.2 330.8-50.6Q337.2-47 340.9-40.8Q344.6-34.6 344.6-26.6Q344.6-18.6 340.9-12.4Q337.2-6.2 330.8-2.6Q324.3 1 316 1ZM316-12.8Q319.6-12.8 322.4-14.6Q325.2-16.4 326.8-19.5Q328.4-22.6 328.3-26.6Q328.4-30.6 326.8-33.8Q325.2-36.9 322.4-38.7Q319.6-40.5 316-40.5Q312.4-40.5 309.5-38.7Q306.7-36.9 305.1-33.8Q303.5-30.6 303.6-26.6Q303.5-22.6 305.1-19.5Q306.7-16.4 309.5-14.6Q312.4-12.8 316-12.8ZM378.4 1Q370.7 1 364.6-2.6Q358.5-6.2 354.9-12.5Q351.4-18.7 351.4-26.6Q351.4-34.5 354.9-40.8Q358.5-47 364.6-50.6Q370.7-54.2 378.4-54.2Q385.5-54.2 391.4-51.7Q397.4-49.2 400.9-44.7L392.2-34.3Q390.8-35.9 388.9-37.3Q387-38.7 384.7-39.5Q382.4-40.3 379.9-40.3Q376.1-40.3 373.2-38.6Q370.3-36.8 368.7-33.7Q367.1-30.6 367.1-26.6Q367.1-22.8 368.8-19.7Q370.4-16.6 373.3-14.8Q376.2-13 379.9-13Q382.5-13 384.7-13.7Q386.9-14.3 388.8-15.6Q390.6-16.9 392.2-18.8L400.8-8.3Q397.4-4 391.4-1.5Q385.3 1 378.4 1Z"/>';

// The wordmark's cap height sits at ~58 % of the mark, as in bluedoc's app bar.
const wmHeight = Math.round(size * 0.62 * 10) / 10;
const wmWidth = Math.round(((wmHeight * 396) / 77) * 10) / 10;
---

<span class:list={['bd-logo inline-flex items-center', className]} style={`gap:${Math.round(size * 0.28)}px`}>
  <svg viewBox="0 0 48 48" width={size} height={size} aria-hidden="true" set:html={MARK} />
  {
    wordmark && (
      <svg class="bd-wm" viewBox="6 -75 396 77" width={wmWidth} height={wmHeight} aria-hidden="true" set:html={WORDMARK} />
    )
  }
</span>

<style>
  .bd-wm :global(.b) {
    fill: var(--logo-blue);
  }
  .bd-wm :global(.d) {
    fill: var(--logo-doc);
  }
</style>
