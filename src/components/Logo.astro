// The bluedoc logo: a "D" whose counter is a page with three text lines and a folded corner (48 × 48),
// plus "bluedoc" set in Lexend Bold and outlined to paths. Both copied unchanged from bluedoc's
// skills/bluedoc/assets/home.html (LOGO and WORDMARK); only the gradient id is made unique per instance.
interface Props {
  /** Mark height in px; the wordmark scales with it. */
  size?: number;
  wordmark?: boolean;
  class?: string;
}

const { size = 28, wordmark = true, class: className } = Astro.props;

let counter = (globalThis as { __bdLogoCount?: number }).__bdLogoCount ?? 0;
(globalThis as { __bdLogoCount?: number }).__bdLogoCount = ++counter;
const gid = `bd-lg-${counter}`;

const MARK =
