---
// One feature on a type page, as a ruled row: its number, title and 1–2 sentences in one cell and its clip in the
// other. Rows alternate sides from 1024 px; below that the clip sits under the text.
import Clip from './Clip.astro';
import type { ClipCopy } from '../content/types';

interface Props {
  item: ClipCopy;
  /** the row's position, from 0: odd rows put the clip on the left */
  index: number;
}

const { item, index } = Astro.props;
---

<article class:list={['feature-row', { flip: index % 2 === 1 }]}>
  <div class="text" data-reveal>
    <p class="label">{String(index + 1).padStart(2, '0')}</p>
    <h3 class="h3 mt-4">{item.title}</h3>
    <p class="mt-3 text-fg-muted">{item.body}</p>
  </div>
  <div class="clip-col" data-reveal="1">
    <Clip name={item.clip} label={item.shows} title={item.title} />
  </div>
</article>

<style>
  .feature-row {
    display: grid;
    border-top: 1px solid var(--rail);
  }
  @media (min-width: 1024px) {
    .feature-row {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    }
    .feature-row.flip {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    }
    .flip .text {
      order: 2;
      border-left: 1px solid var(--rail);
    }
    .feature-row:not(.flip) .clip-col {
      border-left: 1px solid var(--rail);
    }
  }
  .text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.5rem, 3vw, 2.75rem) clamp(1.25rem, 3.5vw, 3rem);
  }
  .clip-col {
    padding: clamp(1rem, 2.5vw, 2rem);
    background:
      linear-gradient(to right, var(--line) 1px, transparent 1px) 0 0 / 1.5rem 1.5rem,
      linear-gradient(to bottom, var(--line) 1px, transparent 1px) 0 0 / 1.5rem 1.5rem;
  }
</style>
