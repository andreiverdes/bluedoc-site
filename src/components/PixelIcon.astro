---
// 12 × 12 pixel icons for the loop. `#` is drawn in currentColor, `+` in --px-accent.
// Runs of one colour on a row are merged into one rect.
import type { LoopIcon } from '../content/site';

interface Props {
  name: LoopIcon;
  size?: number;
  class?: string;
}

const MAPS: Record<LoopIcon, string[]> = {
  write: [
    '.#######....',
    '.#.....##...',
    '.#.....#.#..',
    '.#.....####.',
    '.#.+++....#.',
    '.#........#.',
    '.#.++++++.#.',
    '.#........#.',
    '.#.+++++..#.',
    '.#........#.',
    '.##########.',
    '............',
  ],
  markup: [
    '............',
    '.##########.',
    '.#........#.',
    '.#.++++++.#.',
    '.#........#.',
    '.#.++++...#.',
    '.#........#.',
    '.####..####.',
    '....#.#.....',
    '....##......',
    '....#.......',
    '............',
  ],
  decide: [
    '.....##.....',
    '.....++.....',
    '....#++#....',
    '....#++#....',
    '####++++####',
    '.#++++++++#.',
    '..#++++++#..',
    '...#++++#...',
    '..#++++++#..',
    '..#++##++#..',
    '.#+##..##+#.',
    '.##......##.',
  ],
  revise: [
    '...#####....',
    '..#.....#.#.',
    '.#.......##.',
    '.#......###.',
    '#...........',
    '#....++.....',
    '.....++....#',
    '...........#',
    '.###......#.',
    '.##.......#.',
    '.#.#.....#..',
    '....#####...',
  ],
  approve: [
    '.##########.',
    '#..........#',
    '#.........+#',
    '#........++#',
    '#.......++.#',
    '#.+....++..#',
    '#.++..++...#',
    '#..++++....#',
    '#...++.....#',
    '#..........#',
    '.##########.',
    '............',
  ],
};

const { name, size = 48, class: className } = Astro.props;

const rects: { x: number; y: number; w: number; accent: boolean }[] = [];
MAPS[name].forEach((row, y) => {
  let x = 0;
  while (x < row.length) {
    const c = row[x];
    if (c === '.') {
      x++;
      continue;
    }
    let w = 1;
    while (row[x + w] === c) w++;
    rects.push({ x, y, w, accent: c === '+' });
    x += w;
  }
});
---

<svg
  class={className}
  viewBox="0 0 12 12"
  width={size}
  height={size}
  shape-rendering="crispEdges"
  aria-hidden="true"
>
  {
    rects.map((r) => (
      <rect x={r.x} y={r.y} width={r.w} height="1" fill="currentColor" style={r.accent ? 'fill:var(--px-accent,currentColor)' : undefined} />
    ))
  }
</svg>
