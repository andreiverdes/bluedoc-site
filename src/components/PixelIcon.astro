---
// A 12 × 12 pixel icon from src/lib/pixel-icons.ts. Runs of one colour on a row are merged into one rect.
import { PIXEL_ICONS, type PixelIconName } from '../lib/pixel-icons';

interface Props {
  name: PixelIconName;
  size?: number;
  class?: string;
}

const { name, size = 48, class: className } = Astro.props;

const rects: { x: number; y: number; w: number; accent: boolean }[] = [];
PIXEL_ICONS[name].forEach((row, y) => {
  let x = 0;
  while (x < row.length) {
    const c = row[x];
    if (c === '.') {
      x++;
      continue;
    }
    let w = 1;
    while (row[x + w] === c) w++;
    rects.push({ x, y, w, accent: c === '+' });
    x += w;
  }
});
---

<svg class={className} viewBox="0 0 12 12" width={size} height={size} shape-rendering="crispEdges" aria-hidden="true">
  {
    rects.map((r) => (
      <rect x={r.x} y={r.y} width={r.w} height="1" fill="currentColor" style={r.accent ? 'fill:var(--px-accent,currentColor)' : undefined} />
    ))
  }
</svg>
