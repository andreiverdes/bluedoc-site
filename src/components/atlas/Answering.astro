---
// "Built for answering": three cards over hand-drawn bits of a bluedoc page as it looks today (a pinned comment
// thread over the dock's comment tools; the answer card, with More details, the answers, Other, Tell me more and an
// answer's comment field; a Revisions panel row with Changes from N over a word-level diff), then two wide cards: it
// runs locally (the Settings page) and approval gates the agent (the send dialog over the dock and its end keys).
// Copy from site.ts (features). The drawings are aria-hidden: the card text says what they show.
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Star from '@lucide/astro/icons/star';
import Check from '@lucide/astro/icons/check';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import ChevronUp from '@lucide/astro/icons/chevron-up';
import CircleCheck from '@lucide/astro/icons/circle-check';
import Copy from '@lucide/astro/icons/copy';
import Eye from '@lucide/astro/icons/eye';
import GitCompare from '@lucide/astro/icons/git-compare';
import Info from '@lucide/astro/icons/info';
import MessageCircleMore from '@lucide/astro/icons/message-circle-more';
import MessageCirclePlus from '@lucide/astro/icons/message-circle-plus';
import MousePointer2 from '@lucide/astro/icons/mouse-pointer-2';
import Paperclip from '@lucide/astro/icons/paperclip';
import PenLine from '@lucide/astro/icons/pen-line';
import SquareDashed from '@lucide/astro/icons/square-dashed';
import SquarePen from '@lucide/astro/icons/square-pen';
import Type from '@lucide/astro/icons/type';
import X from '@lucide/astro/icons/x';
import { atlasAnswering as a, atlasRevisionsHref } from '../../content/atlas';
import { rich } from '../../lib/rich';

const [comments, options, revisions] = a.cards;
const wide = [
  { ...a.local, tone: 'off', state: 'Local', art: 'settings' },
  { ...a.approve, tone: 'ok', state: 'Approved · rev 1', art: 'send' },
];
// the Settings page's sections, Agents open
const settingsNav = ['Folders', 'Code links', 'Frameworks', 'Agents', 'Sharing', 'Tools', 'Server'];
---

<section id={a.id} class="av-section" aria-labelledby="answering-title">
  <div class="av-wrap">
    <div class="av-head" data-reveal>
      <h2 id="answering-title" class="h2" set:html={rich(a.title)} />
      <p class="lead">{a.lead}</p>
    </div>

    <ul class="av-three">
      <li class="av-card" data-reveal="0">
        <div class="av-art av-art-h" aria-hidden="true">
          <div class="mock-thread">
            <div class="mock-node">
              orders-api
              <span class="mock-pin">1</span>
            </div>
            <div class="mock-msg">
              <span class="label">You · rev 1</span>
              Split refunds into their own call.
            </div>
            <div class="mock-msg is-agent">
              <span class="label">Claude · rev 2 <b class="mock-new">New</b></span>
              Done: refunds.ts, step 4.
            </div>
            <div class="mock-dock is-tools">
              <span class="dk-k"><MousePointer2 /></span>
              <i class="dk-sep"></i>
              <span class="dk-k is-on"><MessageCirclePlus /></span>
              <span class="dk-k"><SquareDashed /></span>
              <span class="dk-k"><Type /></span>
              <span class="dk-k"><PenLine /></span>
            </div>
          </div>
        </div>
        <div class="av-card-body">
          <h3 class="av-card-title">{comments.title}</h3>
          <p class="av-card-text">{comments.body}</p>
        </div>
      </li>

      <li class="av-card" data-reveal="1">
        <div class="av-art av-art-h" aria-hidden="true">
          <div class="mock-ac">
            <p class="ac-head">
              <span class="ac-q">How long does a saved cart stay?</span>
              <span class="ac-state"><Check /> 180 days</span>
              <ChevronUp class="ac-chev" />
            </p>
            <p class="ac-det"><Info /> More details <ChevronDown class="ac-chev" /></p>
            <div class="ac-opts">
              <p class="ac-opt"><i class="ac-radio"></i> 90 days</p>
              <div class="ac-opt is-on">
                <p class="ac-row">
                  <i class="ac-radio"></i> 180 days
                  <span class="mock-star"><Star /> Recommended</span>
                  <span class="ac-pick">Your pick</span>
                </p>
                <p class="ac-cmt">
                  <span class="ac-ph">Comment on 180 days…</span>
                  <Paperclip class="ac-clip" />
                  <span class="ac-save">Save</span>
                </p>
              </div>
              <p class="ac-opt"><i class="ac-radio"></i> Other <span class="ac-field">Your own answer</span></p>
            </div>
            <p class="ac-tmm"><i class="ac-radio"></i><MessageCircleMore /> Tell me more</p>
          </div>
        </div>
        <div class="av-card-body">
          <h3 class="av-card-title">{options.title}</h3>
          <p class="av-card-text">{options.body}</p>
        </div>
      </li>

      <li class="av-card" data-reveal="2">
        <div class="av-art av-art-h" aria-hidden="true">
          <div class="mock-rev">
            <div class="rv-row">
              <span class="rv-dot">2</span>
              <div class="rv-main">
                <p class="rv-t">Revision 2 <span class="rv-tag">current</span></p>
                <p class="rv-note">Carts stay 180 days; a nightly sweeper clears them.</p>
                <p class="rv-chg"><span><GitCompare /> Changes from 1</span><span>View</span></p>
              </div>
            </div>
            <div class="mock-diff">
              <p>
                Saved carts stay for <del>90</del> <ins>180</ins> days, then a <ins>nightly</ins> sweeper clears them.
              </p>
              <p class="mock-resolved"><Check class="size-3.5" /> 2 comments resolved</p>
            </div>
          </div>
        </div>
        <div class="av-card-body">
          <h3 class="av-card-title">{revisions.title}</h3>
          <p class="av-card-text">{revisions.body}</p>
          <a class="link-arrow mt-2 justify-self-start" href={atlasRevisionsHref}>
            All about revisions
            <ArrowRight class="size-4" aria-hidden="true" />
          </a>
        </div>
      </li>
    </ul>

    <ul class="av-two">
      {
        wide.map((w, i) => (
          <li class="av-card av-wide" data-reveal={String(i)}>
            <div class="av-art av-art-w" aria-hidden="true">
              {w.art === 'settings' ? (
                <div class="mock-set">
                  <ul class="set-nav">
                    {settingsNav.map((s) => (
                      <li class:list={{ 'is-on': s === 'Agents' }}>{s}</li>
                    ))}
                  </ul>
                  <div class="set-main">
                    <p class="set-h">Agents</p>
                    <p class="set-row">
                      Plan mode opens plans here <i class="set-sw is-on" />
                    </p>
                    <p class="set-row">
                      Patch-only edits <i class="set-sw is-on" />
                    </p>
                    <p class="set-h">Sharing</p>
                    <p class="set-row">
                      acme-shop <span class="set-val">acme-dev</span>
                    </p>
                    <p class="set-h">Server</p>
                    <p class="set-row">
                      <span class="set-val is-mono">127.0.0.1:8740</span>
                      <span class="set-btn">Restart server</span>
                    </p>
                  </div>
                </div>
              ) : (
                <div class="mock-sendwrap">
                  <div class="mock-send">
                    <p class="sd-hd">
                      <b>Approve this plan</b>
                      <span class="sd-rev">rev 1</span>
                      <X class="sd-x" />
                    </p>
                    <p class="sd-sub">Claude builds the plan as written, with these decisions.</p>
                    <p class="sd-label">
                      <span>Decisions · 2</span>
                      <span>2 picked</span>
                    </p>
                    <ul class="sd-list">
                      <li>
                        <span>How long does a saved cart stay?</span>
                        <span class="sd-chip">
                          <Check /> 180 days
                        </span>
                      </li>
                      <li>
                        <span>Who can save a cart?</span>
                        <span class="sd-chip">
                          <Check /> Personal, Business
                        </span>
                      </li>
                    </ul>
                    <p class="sd-note">
                      <span class="ac-ph">A note for Claude (optional)</span>
                      <Paperclip class="ac-clip" />
                    </p>
                    <p class="sd-ft">
                      <span class="sd-copy">
                        <Copy /> Copy
                      </span>
                      <span class="sd-go">
                        <CircleCheck /> Approve
                      </span>
                    </p>
                  </div>
                  <div class="mock-dock is-full">
                    <span class="dk-k is-on">
                      <MousePointer2 />
                    </span>
                    <i class="dk-sep" />
                    <span class="dk-tools">
                      <span class="dk-k">
                        <MessageCirclePlus />
                      </span>
                      <span class="dk-k">
                        <SquareDashed />
                      </span>
                      <span class="dk-k">
                        <Type />
                      </span>
                      <span class="dk-k">
                        <PenLine />
                      </span>
                    </span>
                    <span class="dk-k dk-fold">
                      <MessageCirclePlus />
                    </span>
                    <span class="dk-k dk-eye">
                      <Eye />
                    </span>
                    <i class="dk-sep dk-eye" />
                    <span class="dk-end is-go">
                      <SquarePen />
                      <span class="dk-t">Request changes</span>
                      <b>1</b>
                    </span>
                    <span class="dk-end is-ok">
                      <CircleCheck />
                      <span class="dk-t">Approve</span>
                    </span>
                  </div>
                </div>
              )}
            </div>
            <div class="av-wide-body">
              <p class="av-chip" data-tone={w.tone}>
                {w.state}
              </p>
              <h3 class="av-card-title">{w.title}</h3>
              <p class="av-card-text">{w.body}</p>
              <dl class="av-facts">
                {w.facts.map((f) => (
                  <div>
                    <dt class="label">{f.label}</dt>
                    <dd>{f.value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 flex justify-center">
      <a class="link-arrow" href={a.more.href}>
        {a.more.label}
        <ArrowRight class="size-4" aria-hidden="true" />
      </a>
    </p>
  </div>
</section>

<style>
  .av-three,
  .av-two {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 900px) {
    .av-three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .av-two {
      grid-template-columns: 1fr 1fr;
    }
  }
  .av-two {
    margin-top: 1rem;
  }
  .av-art-h {
    height: 19.5rem;
    padding: 1.1rem;
    container-type: inline-size;
  }
  .av-art-w {
    height: 21rem;
    padding: 1.25rem;
    container-type: inline-size;
  }
  .av-art :global(svg) {
    flex: none;
  }

  /* ---- shared bits: small text, the blue star, a field's placeholder and its Save ---- */
  .mock-star {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    font-size: 0.625rem;
    color: var(--brand-fg);
    white-space: nowrap;
  }
  .mock-star :global(svg) {
    width: 0.65rem;
    height: 0.65rem;
    fill: currentColor;
  }
  .ac-ph {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--fg-subtle);
  }
  .ac-clip {
    width: 0.8rem;
    height: 0.8rem;
    color: var(--fg-subtle);
  }

  /* ---- the comment thread, over the dock's comment tools ---- */
  .mock-thread {
    display: grid;
    gap: 0.55rem;
    width: min(100%, 15.5rem);
  }
  .mock-node {
    position: relative;
    justify-self: start;
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--line-strong);
    background-color: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg);
  }
  .mock-pin {
    position: absolute;
    top: -0.6rem;
    right: -0.6rem;
    display: grid;
    place-items: center;
    width: 1.2rem;
    height: 1.2rem;
    background: var(--brand);
    font-family: var(--font-pixel);
    font-size: 0.75rem;
    color: #fff;
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--brand) 30%, transparent);
  }
  .mock-msg {
    display: grid;
    gap: 0.15rem;
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: 0.8125rem;
    color: var(--fg);
  }
  .mock-msg .label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.625rem;
  }
  .mock-msg.is-agent {
    margin-left: 1.5rem;
    border-color: color-mix(in oklab, var(--brand-fg) 40%, var(--line));
    background: color-mix(in oklab, var(--brand) 10%, var(--surface));
  }
  .mock-new {
    padding: 0 0.35rem;
    background: var(--brand);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: #fff;
  }

  /* the dock: a raised pill of round keys; View, a groove, Element · Region · Text · Pen, then (full) the eye and
     the end keys, Request changes in blue and the green send key */
  .mock-dock {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    justify-self: center;
    width: max-content;
    max-width: 100%;
    margin-top: 0.35rem;
    padding: 0.25rem;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    box-shadow: 0 10px 24px -14px rgb(0 0 0 / 0.55);
  }
  .dk-tools {
    display: flex;
    gap: 0.2rem;
  }
  .dk-k {
    display: grid;
    place-items: center;
    width: 1.85rem;
    height: 1.85rem;
    color: var(--fg-muted);
  }
  .dk-k :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
  }
  .dk-k.is-on {
    background: var(--surface-2);
    color: var(--fg);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .dk-sep {
    width: 1px;
    height: 1.1rem;
    margin-inline: 0.15rem;
    background: var(--line-strong);
  }
  .dk-fold {
    display: none;
  }
  .dk-end {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    height: 1.85rem;
    padding-inline: 0.7rem;
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
  }
  .dk-end :global(svg) {
    width: 0.85rem;
    height: 0.85rem;
  }
  .dk-end.is-go {
    border: 1px solid color-mix(in oklab, var(--brand-fg) 55%, transparent);
    background: color-mix(in oklab, var(--brand) 16%, var(--surface));
    color: var(--brand-fg);
  }
  .dk-end.is-go b {
    display: grid;
    place-items: center;
    min-width: 1.1rem;
    height: 1.1rem;
    padding-inline: 0.25rem;
    background: var(--brand);
    font-size: 0.625rem;
    color: #fff;
  }
  .dk-end.is-ok {
    background: var(--av-go);
    color: #fff;
  }
  /* as the room narrows, the dock does what bluedoc's does: the four tools fold into one key, then the end keys drop
     their words */
  @container (max-width: 30rem) {
    .dk-tools,
    .dk-eye {
      display: none;
    }
    .dk-fold {
      display: grid;
    }
  }
  @container (max-width: 21rem) {
    .dk-end .dk-t {
      display: none;
    }
  }

  /* ---- the answer card: head, More details, the answers (the pick open on its comment field), Other, Tell me
     more ---- */
  .mock-ac {
    display: grid;
    gap: 0.4rem;
    width: min(100%, 17.5rem);
    padding: 0.7rem;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    font-size: 0.75rem;
    color: var(--fg);
  }
  .ac-head {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 500;
  }
  .ac-q {
    flex: 1;
    min-width: 0;
    line-height: 1.3;
  }
  .ac-state {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    font-size: 0.625rem;
    font-weight: 450;
    color: var(--av-ok);
    white-space: nowrap;
  }
  .ac-state :global(svg),
  .ac-chev {
    width: 0.75rem;
    height: 0.75rem;
  }
  .ac-chev {
    color: var(--fg-subtle);
  }
  .ac-det {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    height: 1.7rem;
    padding-inline: 0.55rem;
    border: 1px solid color-mix(in oklab, var(--brand-fg) 60%, transparent);
    background: var(--surface-2);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--fg-muted);
  }
  .ac-det :global(svg:first-child) {
    width: 0.75rem;
    height: 0.75rem;
  }
  .ac-det .ac-chev {
    margin-left: auto;
  }
  .ac-opts {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .ac-opt {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 1.85rem;
    padding: 0.3rem 0.55rem;
    color: var(--fg-muted);
  }
  .ac-opt + .ac-opt {
    border-top: 1px solid var(--line);
  }
  .ac-opt.is-on {
    display: grid;
    gap: 0.35rem;
    background: color-mix(in oklab, var(--brand) 12%, var(--surface));
    color: var(--fg);
  }
  .ac-row {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .ac-pick {
    margin-left: auto;
    font-size: 0.625rem;
    color: var(--fg-subtle);
    white-space: nowrap;
  }
  .ac-radio {
    flex: none;
    width: 0.75rem;
    height: 0.75rem;
    border: 1px solid var(--line-strong);
  }
  .is-on > .ac-row .ac-radio {
    border: 3px solid var(--brand);
    background: #fff;
  }
  .ac-field {
    flex: 1;
    min-width: 0;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--line);
    background: var(--bg-2);
    font-size: 0.6875rem;
    color: var(--fg-subtle);
    white-space: nowrap;
    overflow: hidden;
  }
  .ac-cmt,
  .sd-note {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.2rem 0.2rem 0.6rem;
    border: 1px solid var(--line-strong);
    background: var(--bg-2);
    font-size: 0.6875rem;
  }
  .ac-save {
    padding: 0.15rem 0.55rem;
    background: var(--brand);
    font-size: 0.625rem;
    font-weight: 500;
    color: #fff;
  }
  .ac-tmm {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    height: 1.8rem;
    padding-inline: 0.55rem;
    border: 1px solid var(--line-strong);
    background: var(--surface-2);
    box-shadow: 0 6px 14px -10px rgb(0 0 0 / 0.5);
    font-weight: 500;
    color: var(--fg);
  }
  .ac-tmm :global(svg) {
    width: 0.8rem;
    height: 0.8rem;
    color: var(--fg-muted);
  }

  /* ---- a Revisions panel row ending in Changes from 1 | View, over the word-level diff ---- */
  .mock-rev {
    display: grid;
    gap: 0.75rem;
    width: min(100%, 16.5rem);
  }
  .rv-row {
    display: flex;
    gap: 0.6rem;
    padding: 0.65rem 0.7rem;
    border: 1px solid var(--line-strong);
    background: color-mix(in oklab, var(--brand) 9%, var(--surface));
  }
  .rv-dot {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    background: var(--brand);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: #fff;
  }
  .rv-main {
    display: grid;
    justify-items: start;
    gap: 0.3rem;
    min-width: 0;
  }
  .rv-t {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--fg);
  }
  .rv-tag {
    padding: 0 0.4rem;
    border: 1px solid color-mix(in oklab, var(--av-ok) 45%, transparent);
    font-size: 0.5625rem;
    font-weight: 450;
    color: var(--av-ok);
  }
  .rv-note {
    font-size: 0.6875rem;
    line-height: 1.4;
    color: var(--fg-muted);
  }
  .rv-chg {
    display: inline-flex;
    margin-top: 0.15rem;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--fg);
  }
  .rv-chg span {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.6rem;
  }
  .rv-chg span + span {
    border-left: 1px solid var(--line-strong);
    color: var(--fg-muted);
  }
  .rv-chg :global(svg) {
    width: 0.7rem;
    height: 0.7rem;
  }
  .mock-diff {
    display: grid;
    justify-items: start;
    gap: 0.6rem;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--fg);
  }
  .mock-diff del {
    color: var(--fg-subtle);
    text-decoration-color: var(--av-del);
    background: color-mix(in oklab, var(--av-del) 12%, transparent);
  }
  .mock-diff ins {
    text-decoration: none;
    background: color-mix(in oklab, var(--av-ok) 22%, transparent);
    box-shadow: inset 0 -1px 0 var(--av-ok);
  }
  .mock-resolved {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    color: var(--av-ok);
  }

  /* ---- the Settings page: its sections beside Agents, Sharing and Server ---- */
  .mock-set {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    width: min(100%, 25rem);
    padding: 0.75rem;
    border: 1px solid var(--line-strong);
    background: var(--surface);
