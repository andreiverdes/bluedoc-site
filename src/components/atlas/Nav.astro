---
// A floating capsule nav, centred over the page: logo, the Doc types menu (every type's page), two anchors, theme,
// GitHub and Install; below 820 px one menu holds the links and the type pages. The scrolled state, the theme
// switch and closing the menus (Escape, a click outside, a picked link) come from src/scripts/site.ts
// ([data-nav], [data-nav-sentinel], [data-theme-toggle], [data-nav-types], [data-nav-menu]).
import Sun from '@lucide/astro/icons/sun';
import Moon from '@lucide/astro/icons/moon';
import Menu from '@lucide/astro/icons/menu';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import Logo from '../Logo.astro';
import GithubMark from '../GithubMark.astro';
import PixelIcon from '../PixelIcon.astro';
import { atlasBase, atlasNav } from '../../content/atlas';

const onHome = Astro.url.pathname === atlasBase;
const { types } = atlasNav;
---

<div data-nav-sentinel aria-hidden="true" class="pointer-events-none absolute top-0 left-0 h-6 w-px"></div>
<header class="av-nav" data-nav>
  <nav aria-label="Main" class="av-nav-in">
    <a href={onHome ? '#top' : atlasBase} class="av-brand" aria-label={onHome ? 'bluedoc, back to top' : 'bluedoc home'}>
      <Logo size={22} />
    </a>
    <ul class="av-links">
      <li>
        <details class="av-types" data-nav-types>
          <summary class="av-link">
            {types.label}
            <ChevronDown class="av-chev size-3.5" aria-hidden="true" />
          </summary>
          <div class="av-panel av-types-panel">
            <ul class="av-types-list">
              {
                types.pages.map((t) => (
                  <li>
                    <a class="av-type" href={t.href} aria-current={Astro.url.pathname === t.href ? 'page' : undefined}>
                      <PixelIcon name={t.id} size={18} />
                      <span class="grid gap-0.5">
                        <span class="font-medium text-fg">{t.name}</span>
                        <span class="text-[0.8125rem] leading-snug text-fg-muted">{t.pitch}</span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
            <a class="av-types-all label" href={types.all.href}>{types.all.label} ↓</a>
          </div>
        </details>
      </li>
      {
        atlasNav.links.map((l) => (
          <li>
            <a class="av-link" href={l.href}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="av-nav-end">
      <button type="button" class="av-icon" data-theme-toggle aria-label="Switch to light theme">
        <Sun class="i-sun size-4" aria-hidden="true" />
        <Moon class="i-moon size-4" aria-hidden="true" />
      </button>
      <a class="av-icon av-gh" href={atlasNav.github.href} rel="noopener">
        <GithubMark class="size-4" />
        <span class="max-sm:sr-only">{atlasNav.github.label}</span>
      </a>
      <details class="av-menu" data-nav-menu>
        <summary class="av-icon" aria-label="Menu">
          <Menu class="size-4" aria-hidden="true" />
        </summary>
        <div class="av-panel av-menu-panel">
          <p class="av-menu-label label">{types.label}</p>
          <ul>
            {
              types.pages.map((t) => (
                <li>
                  <a class="av-menu-link" href={t.href} aria-current={Astro.url.pathname === t.href ? 'page' : undefined}>
                    <PixelIcon name={t.id} size={16} />
                    {t.name}
                  </a>
                </li>
              ))
            }
          </ul>
          <ul class="av-menu-more">
            {
              atlasNav.links.map((l) => (
                <li>
                  <a class="av-menu-link" href={l.href}>
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </details>
      <a class="av-install" href={atlasNav.install.href}>{atlasNav.install.label}</a>
    </div>
  </nav>
</header>

<style>
  .av-nav {
    position: fixed;
    inset: 14px 0 auto;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding-inline: 12px;
    pointer-events: none;
  }
  .av-nav-in {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    width: min(100%, 46rem);
    height: 3rem;
    padding: 0 0.4rem 0 1.2rem;
    border-radius: var(--av-pill);
    pointer-events: auto;
    border: 1px solid var(--line-strong);
    background-color: color-mix(in oklab, var(--bg) 66%, transparent);
    backdrop-filter: blur(18px) saturate(1.6);
    -webkit-backdrop-filter: blur(18px) saturate(1.6);
    box-shadow: 0 10px 30px -12px rgb(0 0 0 / 0.45);
    transition:
      height 0.35s var(--ease-out-soft),
      background-color 0.35s;
  }
  .av-nav:global(.is-scrolled) .av-nav-in {
    height: 2.75rem;
    background-color: color-mix(in oklab, var(--bg) 84%, transparent);
  }
  .av-brand {
    display: inline-flex;
    flex: none;
  }
  .av-links {
    display: none;
    gap: 0.15rem;
  }
  @media (min-width: 820px) {
    .av-links {
      display: flex;
    }
  }
  .av-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    height: 2rem;
    padding-inline: 0.75rem;
    border-radius: var(--av-pill);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
    cursor: pointer;
    list-style: none;
    transition:
      color 0.15s,
      background-color 0.15s;
  }
  .av-link::-webkit-details-marker,
  .av-menu summary::-webkit-details-marker {
    display: none;
  }
  .av-link:hover,
  .av-types[open] .av-link {
    color: var(--fg);
    background: var(--line);
  }
  .av-chev {
    transition: transform 0.2s var(--ease-out-soft);
  }
  .av-types[open] .av-chev {
    transform: rotate(180deg);
  }

  /* the menus' panels: square, hairline, on the page's surface */
  .av-types,
  .av-menu {
    position: relative;
  }
  .av-panel {
    position: absolute;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    box-shadow: 0 24px 60px -24px rgb(0 0 0 / 0.5);
    border-radius: var(--av-r);
    overflow: hidden;
  }
  .av-types-panel {
    top: calc(100% + 0.9rem);
    left: -1.2rem;
    width: 38rem;
  }
  .av-types-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .av-type {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    height: 100%;
    padding: 0.8rem 0.9rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.875rem;
    transition: background-color 0.15s;
  }
  .av-types-list > li:nth-child(odd) .av-type {
    border-right: 1px solid var(--line);
  }
  .av-type :global(svg) {
    flex: none;
    margin-top: 0.1rem;
  }
  .av-type:hover,
  .av-type[aria-current='page'] {
    background: var(--line);
  }
  .av-types-all {
    display: block;
    padding: 0.7rem 0.9rem;
    color: var(--fg-muted);
  }
  .av-types-all:hover {
    color: var(--brand-fg);
  }

  /* below 820 px: one menu for the links and the type pages */
  @media (min-width: 820px) {
    .av-menu {
      display: none;
    }
  }
  .av-menu summary {
    list-style: none;
  }
  .av-menu-panel {
    top: calc(100% + 0.8rem);
    right: 0;
    width: 15rem;
    max-height: calc(100dvh - 6rem);
    overflow-y: auto;
    padding: 0.35rem;
  }
  .av-menu-label {
    padding: 0.55rem 0.6rem 0.25rem;
  }
  .av-menu-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.6rem;
    border-radius: var(--av-r-sm);
    font-size: 0.9375rem;
    color: var(--fg-muted);
  }
  .av-menu-link:hover,
  .av-menu-link[aria-current='page'] {
    color: var(--fg);
    background: var(--line);
  }
  .av-menu-more {
    margin-top: 0.35rem;
    padding-top: 0.35rem;
    border-top: 1px solid var(--line);
  }
  .av-nav-end {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-left: auto;
  }
  .av-icon,
  .av-install {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--av-pill);
    gap: 0.45rem;
    height: 2.125rem;
    min-width: 2.125rem;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      color 0.15s,
      border-color 0.15s,
      background-color 0.15s;
  }
  .av-icon {
    border: 1px solid var(--line-strong);
    color: var(--fg-muted);
  }
  .av-icon:hover {
    color: var(--fg);
    border-color: var(--brand-fg);
  }
  .av-gh {
    padding-inline: 0.7rem;
    color: var(--fg);
  }
  .av-install {
    padding-inline: 1rem;
    background: var(--brand);
    color: #fff;
  }
  .av-install:hover {
    background: #2b82ff;
  }
  :global([data-theme='dark'] .i-moon),
  :global([data-theme='light'] .i-sun) {
    display: none;
  }
</style>
