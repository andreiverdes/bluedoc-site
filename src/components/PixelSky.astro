---
// A pixel starfield drawn on a coarse grid at build time, so it stays crisp; some stars twinkle. Seeded, so every
// build draws the same sky. The parent places and masks it through `class`.
interface Props {
  seed?: number;
  count?: number;
  class?: string;
}

const { seed: start = 7, count = 140, class: className } = Astro.props;
let seed = start;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;

const SKY_W = 320;
const SKY_H = 120;
const stars = Array.from({ length: count }, () => {
  const big = rand() > 0.88;
  return {
    x: Math.floor(rand() * SKY_W),
    y: Math.floor(rand() * SKY_H),
    s: big ? 2 : 1,
    o: (0.35 + rand() * 0.65).toFixed(2),
    tw: rand() > 0.82,
    d: (rand() * 4).toFixed(2),
  };
});
---

<svg class={className} viewBox={`0 0 ${SKY_W} ${SKY_H}`} preserveAspectRatio="xMidYMid slice" shape-rendering="crispEdges" aria-hidden="true">
  {
    stars.map((s) => (
      <rect x={s.x} y={s.y} width={s.s} height={s.s} class:list={['star', { tw: s.tw }]} style={`opacity:${s.o};animation-delay:${s.d}s`} />
    ))
  }
</svg>

<style>
  .star {
    fill: #dbe9ff;
  }
  @media (prefers-reduced-motion: no-preference) {
    .star.tw {
      animation: twinkle 3.2s steps(2, jump-none) infinite;
    }
  }
  @keyframes twinkle {
    50% {
      opacity: 0.15;
    }
  }
</style>
