---
// The closing row, a band under a pixel sky: the closing line and the two ways in.
import ArrowDown from '@lucide/astro/icons/arrow-down';
import GithubMark from './GithubMark.astro';
import PixelSky from './PixelSky.astro';
import Row from './Row.astro';
import { finalCta } from '../content/site';
import { rich } from '../lib/rich';

interface Props {
  n?: string;
}

const { n } = Astro.props;
---

<Row n={n} band labelledby="cta-title" class="overflow-hidden">
  <div slot="back" class="cta-back" aria-hidden="true">
    <PixelSky class="sky" seed={5} count={220} />
  </div>
  <div class="rail-pad cta-body">
    <p class="kicker" data-reveal>{finalCta.kicker}</p>
    <h2 id="cta-title" class="display mt-7" data-reveal="1" set:html={rich(finalCta.title)} />
    <p class="lead mt-7 max-w-[34rem]" data-reveal="2">{finalCta.body}</p>
    <div class="mt-10 flex flex-wrap items-center gap-3" data-reveal="3">
      <a class="btn btn-primary" href={finalCta.primary.href} rel="noopener">
        <GithubMark class="size-4" />
        {finalCta.primary.label}
      </a>
      <a class="btn btn-box" href={finalCta.secondary.href}>
        {finalCta.secondary.label}
        <ArrowDown class="size-4" aria-hidden="true" />
      </a>
    </div>
  </div>
</Row>

<style>
  .cta-back {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 60% at 85% 100%, rgb(10 109 255 / 0.32), transparent 70%);
    /* stars thicken towards the right, away from the heading */
    -webkit-mask-image: linear-gradient(to right, rgb(0 0 0 / 0.18) 15%, #000 75%);
    mask-image: linear-gradient(to right, rgb(0 0 0 / 0.18) 15%, #000 75%);
  }
  .cta-back :global(.sky) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .cta-body {
    position: relative;
    padding-block: clamp(5rem, 3rem + 9vw, 10rem);
  }
</style>
