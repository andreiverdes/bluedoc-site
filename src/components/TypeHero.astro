---
// The top of a showcase page (a type page or the Features page) in two ruled rows: the strip with the kicker and
// the type's `"type"` value (01), then the page's large heading, its title, pitch and buttons beside the hero clip
// (02). The hero clip is the only one that loads early.
import ArrowDown from '@lucide/astro/icons/arrow-down';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Clip from './Clip.astro';
import PixelIcon from './PixelIcon.astro';
import Row from './Row.astro';
import { repoUrl } from '../content/site';
import type { ClipCopy } from '../content/types';

interface Props {
  kicker: string;
  /** the large heading: the type's name (Documentation, Plans…) */
  display: string;
  title: string;
  pitch: string;
  hero: ClipCopy & { url: string };
  /** the doc type's `"type"` value, shown in the strip */
  tag?: string;
}

const { kicker, display, title, pitch, hero, tag } = Astro.props;
---

<div id="top" class="pt-16">
  <Row n="01" plain>
    <p class="strip label">
      <span class="live" aria-hidden="true"></span>
      {kicker}
      {tag && <code class="strip-tag">"type": "{tag}"</code>}
    </p>
  </Row>

  <Row n="02" labelledby="type-title">
    <div class="rail-pad type-body">
      <h1 id="type-title" class="display type-display enter">
        <PixelIcon name="spark" size={40} class="type-spark" />{display}
      </h1>
      <div class="type-grid">
        <div class="type-copy enter" style="--d:0.15s">
          <p class="h3">{title}</p>
          <p class="lead mt-5">{pitch}</p>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a class="btn btn-primary" href="#install">
              <ArrowDown class="size-4" aria-hidden="true" />
              Install
            </a>
            <a class="link-arrow" href={repoUrl} rel="noopener">
              View on GitHub
              <ArrowUpRight class="size-4" aria-hidden="true" />
            </a>
          </div>
        </div>
        <div class="enter" style="--d:0.3s">
          <Clip name={hero.clip} label={hero.shows} title={hero.title} url={hero.url} priority />
          <p class="caption">
            <span class="font-medium text-fg">{hero.title}.</span>{' '}
            {hero.body}
          </p>
        </div>
      </div>
    </div>
  </Row>
</div>

<style>
  .strip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    height: 2.6rem;
    background: var(--surface);
    color: var(--fg-muted);
  }
  .strip-tag {
    margin-left: 0.4rem;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--line-strong);
    text-transform: none;
    letter-spacing: 0;
    color: var(--brand-fg);
  }
  .live {
    width: 6px;
    height: 6px;
    background: var(--brand-fg);
    box-shadow: 0 0 10px var(--brand-fg);
  }
  .type-body {
    padding-block: clamp(3rem, 2rem + 5vw, 6rem) clamp(3rem, 2rem + 4vw, 5.5rem);
  }
  .type-display :global(.type-spark) {
    display: inline-block;
    width: 0.42em;
    height: 0.42em;
    margin-right: 0.22em;
    vertical-align: 0.08em;
    color: var(--fg);
    --px-accent: var(--brand-fg);
  }
  /* minmax(0, …): a long address in the clip's browser bar must not widen the column past the screen */
  .type-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
    margin-top: clamp(2rem, 1.4rem + 2vw, 3.25rem);
  }
  @media (min-width: 1024px) {
    .type-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 3.5rem;
    }
  }
  .caption {
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--fg-muted);
  }
</style>
