---
// Row 10: the questions as numbered disclosure rows beside the title.
import Plus from '@lucide/astro/icons/plus';
import Row from './Row.astro';
import { faq } from '../content/site';
import { rich } from '../lib/rich';
---

<Row n="10" id={faq.id} labelledby="faq-title">
  <div class="faq rail-pad row-y">
    <div data-reveal>
      <p class="kicker">{faq.kicker}</p>
      <h2 id="faq-title" class="h2 mt-5" set:html={rich(faq.title)} />
    </div>
    <div class="list" data-reveal="1">
      {
        faq.items.map((item, i) => (
          <details class="qa">
            <summary class="q">
              <span class="q-n">{String(i + 1).padStart(2, '0')}</span>
              <span class="flex-1">{item.q}</span>
              <Plus class="q-icon size-4" aria-hidden="true" />
            </summary>
            <p class="a">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</Row>

<style>
  .faq {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 1024px) {
    .faq {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 4rem;
    }
  }
  .list {
    border-top: 1px solid var(--line);
  }
  .qa {
    border-bottom: 1px solid var(--line);
  }
  .q {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-block: 1.25rem;
    font-size: 1.0625rem;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }
  .q::-webkit-details-marker {
    display: none;
  }
  .q:hover {
    color: var(--brand-fg);
  }
  .q-n {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--fg-subtle);
  }
  .q :global(.q-icon) {
    flex: none;
    color: var(--fg-subtle);
    transition: rotate 0.25s var(--ease-out-soft);
  }
  .qa[open] :global(.q-icon) {
    rotate: 45deg;
    color: var(--brand-fg);
  }
  .a {
    max-width: 40rem;
    padding: 0 2.5rem 1.4rem 2.6rem;
    color: var(--fg-muted);
  }
  @media (prefers-reduced-motion: no-preference) {
    .qa[open] .a {
      animation: open 0.35s var(--ease-out-soft);
    }
  }
  @keyframes open {
    from {
      opacity: 0;
      translate: 0 -4px;
    }
  }
</style>
