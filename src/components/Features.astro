---
// Row 07: the six features every doc type has, as ruled cells with a pixel icon each.
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Row from './Row.astro';
import SectionHead from './SectionHead.astro';
import PixelIcon from './PixelIcon.astro';
import { features } from '../content/site';
---

<Row n="07" id={features.id} labelledby="features-title">
  <SectionHead kicker={features.kicker} title={features.title} titleId="features-title" lead={features.lead}>
    <a class="link-arrow mt-5" href={features.more.href}>
      {features.more.label}
      <ArrowUpRight class="size-4" aria-hidden="true" />
    </a>
  </SectionHead>

  <ul class="grid-cells">
    {
      features.items.map((f, i) => (
        <li class="cell" data-reveal={String(i % 3)}>
          <PixelIcon name={f.icon} size={36} class="cell-icon" />
          <h3 class="mt-8 text-lg leading-snug font-medium tracking-tight">{f.title}</h3>
          <p class="mt-2.5 text-[0.9375rem] text-fg-muted">{f.body}</p>
        </li>
      ))
    }
  </ul>
</Row>

<style>
  .grid-cells {
    display: grid;
    border-top: 1px solid var(--rail);
  }
  @media (min-width: 640px) {
    .grid-cells {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .grid-cells {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .cell {
    padding: clamp(1.5rem, 2.5vw, 2.25rem);
    border-right: 1px solid var(--rail);
    border-bottom: 1px solid var(--rail);
    margin-bottom: -1px;
    transition: background-color 0.25s;
  }
  .cell:hover {
    background: var(--surface);
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .cell:nth-child(2n) {
      border-right: 0;
    }
  }
  @media (min-width: 1024px) {
    .cell:nth-child(3n) {
      border-right: 0;
    }
  }
  @media (max-width: 639px) {
    .cell {
      border-right: 0;
    }
  }
  .cell :global(.cell-icon) {
    color: var(--fg-subtle);
    --px-accent: var(--brand-fg);
    transition: color 0.25s;
  }
  .cell:hover :global(.cell-icon) {
    color: var(--fg);
  }
</style>
