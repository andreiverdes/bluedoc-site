---
// Row 05: the loop's five steps around one full-width stage. On a desktop the row pins while it scrolls past: a bar
// of the five steps runs across the top and fills as you go, the stage under it shows the current step's clip as
// wide as the column allows, and the step's tag and line sit beneath (motion.ts, [data-steps]). A step in the bar
// jumps there. Below 1024 px the steps simply stack, each with its own clip. The first step shows the start of the
// JSON the agent writes instead of a clip.
import Row from './Row.astro';
import SectionHead from './SectionHead.astro';
import Clip from './Clip.astro';
import PixelIcon from './PixelIcon.astro';
import { codePeek, loop } from '../content/site';
import { highlightJson } from '../lib/highlight';
import { rich } from '../lib/rich';

const total = String(loop.steps.length).padStart(2, '0');
const json = codePeek.snippet.split('\n').slice(0, 17).map(highlightJson);
---

<Row n="05" id={loop.id} labelledby="loop-title">
  <SectionHead kicker={loop.kicker} title={loop.title} titleId="loop-title" lead={loop.lead} class="pb-10!" />

  <div class="loop" data-steps style={`--steps:${loop.steps.length}`}>
    <div class="sticky-box">
      <ol class="bar">
        {
          loop.steps.map((s, i) => (
            <li>
              <button type="button" class="bar-step" data-step-go data-on={i === 0 ? '' : undefined} style="--fill:0">
                <span class="bar-head">
                  <PixelIcon name={s.icon} size={18} class="bar-icon" />
                  <span class="bar-n">{String(i + 1).padStart(2, '0')}</span>
                </span>
                <span class="bar-title" set:html={rich(s.title)} />
                <span class="bar-fill" aria-hidden="true" />
              </button>
            </li>
          ))
        }
      </ol>

      <ol class="slides">
        {
          loop.steps.map((s, i) => (
            <li class="slide" data-step data-on={i === 0 ? '' : undefined}>
              <div class="slide-media">
                {s.clip ? (
                  <Clip name={s.clip.clip} label={s.clip.shows} title={s.clip.title} />
                ) : (
                  <figure class="mini-editor" aria-label={`The start of ${codePeek.fileName}`}>
                    <figcaption class="label">{codePeek.fileName}</figcaption>
                    <pre><code>{json.map((html, n) => (
                      <span class="ln"><span class="gut" aria-hidden="true">{n + 1}</span><span set:html={html || ' '} /></span>
                    ))}</code></pre>
                  </figure>
                )}
              </div>
              <div class="slide-text">
                <span class="label slide-n">
                  {String(i + 1).padStart(2, '0')} / {total}
                </span>
                <h3 class="slide-title" set:html={rich(s.title)} />
                <span class="pill">{s.tag}</span>
                <p class="slide-body">{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</Row>

<style>
  .loop {
    padding: 0 clamp(1.25rem, 3.5vw, 3rem) clamp(3rem, 2rem + 4vw, 6rem);
  }
  .bar {
    display: none;
  }
  .slides {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3.5rem;
  }
  .slide-text {
    display: grid;
    justify-items: start;
    gap: 0.9rem;
    margin-top: 1.5rem;
  }
  .slide-title {
    font-size: clamp(2rem, 1.4rem + 2vw, 3rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .slide-body {
    max-width: 36rem;
    font-size: 1.0625rem;
    color: var(--fg-muted);
  }

  .mini-editor {
    margin: 0;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    aspect-ratio: 1280 / 800;
    overflow: hidden;
  }
  .mini-editor figcaption {
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--line);
  }
  .mini-editor pre {
    margin: 0;
    padding: 0.9rem 0;
    font-family: var(--font-mono);
    font-size: clamp(0.68rem, 0.5rem + 0.5vw, 1rem);
    line-height: 1.7;
    white-space: pre;
    overflow: hidden;
  }
  .mini-editor code {
    display: grid;
  }
  .ln {
    display: flex;
  }
  .gut {
    flex: none;
    width: 3rem;
    padding-right: 1rem;
    text-align: right;
    color: var(--fg-subtle);
  }
  .mini-editor :global(.k) {
    color: var(--code-key);
  }
  .mini-editor :global(.s) {
    color: var(--code-str);
  }
  .mini-editor :global(.n) {
    color: var(--code-num);
  }
  .mini-editor :global(.p) {
    color: var(--code-punct);
  }

  /* Desktop with JS: a tall row (about 70 vh of scroll a step) whose sticky box holds the bar, the stage and the
     caption. All slides share one grid cell and crossfade; the stage is as wide as the column, unless the screen
     is too short for that, when it keeps its 16:10 shape and narrows. */
  @media (min-width: 1024px) {
    :global(.js) .loop {
      height: calc(var(--steps) * 70vh + 30vh);
      padding-bottom: 0;
    }
    :global(.js) .sticky-box {
      position: sticky;
      top: 4rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 1.5rem;
      height: calc(100vh - 4rem);
      padding-block: 1.5rem;
    }
    :global(.js) .bar {
      display: grid;
      grid-template-columns: repeat(var(--steps), minmax(0, 1fr));
      border: 1px solid var(--line);
      background: var(--surface);
    }
    .bar > li + li {
      border-left: 1px solid var(--line);
    }
    .bar-step {
      position: relative;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      width: 100%;
      padding: 0.85rem 1rem;
      text-align: left;
      color: var(--fg-subtle);
      cursor: pointer;
      transition:
        color 0.3s,
        background-color 0.3s;
    }
    .bar-step:hover {
      color: var(--fg-muted);
    }
    .bar-step:focus-visible {
      outline-offset: -2px;
    }
    .bar-step[data-on] {
      color: var(--fg);
      background: var(--brand-tint);
    }
    .bar-head {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .bar-step :global(.bar-icon) {
      --px-accent: currentColor;
    }
    .bar-step[data-on] :global(.bar-icon) {
      --px-accent: var(--brand-fg);
    }
    .bar-n {
      font-family: var(--font-mono);
      font-size: 0.6875rem;
    }
    .bar-title {
      font-size: 0.9375rem;
      font-weight: 500;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .bar-title :global(.h-soft) {
      color: inherit;
      opacity: 0.7;
    }
    /* how far the page has scrolled through this step */
    .bar-fill {
      position: absolute;
      left: 0;
      right: 0;
      bottom: -1px;
      height: 2px;
      background: var(--brand-fg);
      transform-origin: left;
      transform: scaleX(var(--fill));
    }

    :global(.js) .slides {
      gap: 0;
      flex: 0 1 auto;
      min-height: 0;
    }
    :global(.js) .slide {
      grid-area: 1 / 1;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.45s var(--ease-out-soft);
    }
    :global(.js) .slide[data-on] {
      opacity: 1;
      pointer-events: auto;
    }
    /* 16:10 plus the clip's frame; the height left under the bar and over the caption caps the width */
    :global(.js) .slide-media {
      width: min(100%, calc((100vh - 4rem - 15rem) * 1.6));
      scale: 0.985;
      transition: scale 0.6s var(--ease-out-soft);
    }
    :global(.js) .slide[data-on] .slide-media {
      scale: 1;
    }
    :global(.js) .slide-text {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: center;
      gap: 0.5rem 1.25rem;
      width: 100%;
      margin-top: 1.25rem;
    }
    :global(.js) .slide-n,
    :global(.js) .slide-title {
      display: none;
    }
    :global(.js) .slide-body {
      font-size: 1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .slide,
    .slide-media,
    .bar-step {
      transition: none;
    }
  }
</style>
