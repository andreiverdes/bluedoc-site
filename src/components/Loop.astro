---
import PixelIcon from './PixelIcon.astro';
import { loop } from '../content/site';
---

<section id={loop.id} class="loop-section section-y" aria-labelledby="loop-title">
  <div class="container-x">
    <div class="max-w-2xl" data-reveal>
      <p class="kicker">{loop.kicker}</p>
      <h2 id="loop-title" class="h2 mt-4">{loop.title}</h2>
      <p class="lead mt-5">{loop.lead}</p>
    </div>

    <ol class="loop mt-14 sm:mt-20" data-loop style={`--n:${loop.steps.length}`}>
      <li class="track" aria-hidden="true"><span class="track-fill"></span></li>
      {
        loop.steps.map((s, i) => (
          <li class:list={['step', { last: i === loop.steps.length - 1 }]} style={`--i:${i}`}>
            <span class="node">
              <PixelIcon name={s.icon} size={36} />
            </span>
            <span class="num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="step-title">{s.title}</h3>
            <p class="step-body">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .loop-section {
    background:
      radial-gradient(60% 50% at 80% 0%, color-mix(in oklab, var(--brand) 10%, transparent), transparent 70%),
      linear-gradient(to bottom, var(--bg), var(--bg-2) 50%, var(--bg));
  }
  .loop {
    --gap: clamp(1rem, 2vw, 2rem);
    --node: 4.5rem;
    --stagger: 420ms;
    position: relative;
    display: grid;
    gap: 2.25rem;
    list-style: none;
  }
  @media (min-width: 900px) {
    .loop {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
      gap: var(--gap);
    }
  }

  /* the rail between the nodes: vertical on phones, horizontal from 900 px */
  .track {
    position: absolute;
    left: calc(var(--node) / 2 - 1px);
    top: calc(var(--node) / 2);
    bottom: calc(var(--node) / 2);
    width: 2px;
    background: repeating-linear-gradient(to bottom, var(--line-strong) 0 4px, transparent 4px 8px);
  }
  .track-fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, var(--brand), var(--cyan), var(--amber));
    transform-origin: top;
    box-shadow: 0 0 12px var(--glow);
  }
  @media (min-width: 900px) {
    .track {
      left: calc(100% / var(--n) / 2);
      right: calc(100% / var(--n) / 2);
      top: calc(var(--node) / 2 - 1px);
      bottom: auto;
      width: auto;
      height: 2px;
      background: repeating-linear-gradient(to right, var(--line-strong) 0 4px, transparent 4px 8px);
    }
    .track-fill {
      background: linear-gradient(to right, var(--brand), var(--cyan), var(--amber));
      transform-origin: left;
    }
  }

  .step {
    position: relative;
    display: grid;
    grid-template-columns: var(--node) 1fr;
    column-gap: 1.25rem;
    align-items: start;
    --px-accent: var(--cyan);
  }
  .step.last {
    --px-accent: var(--amber);
  }
  @media (min-width: 900px) {
    .step {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }
  }
  .node {
    grid-row: span 3;
    display: grid;
    place-items: center;
    width: var(--node);
    height: var(--node);
    border-radius: 1.1rem;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--fg);
    box-shadow:
      0 0 0 6px var(--bg-2),
      0 0 28px -4px var(--glow);
    image-rendering: pixelated;
  }
  .step.last .node {
    border-color: color-mix(in oklab, var(--amber) 60%, transparent);
    box-shadow:
      0 0 0 6px var(--bg-2),
      0 0 32px -2px color-mix(in oklab, var(--amber) 45%, transparent);
  }
  @media (min-width: 900px) {
    .node {
      grid-row: auto;
    }
  }
  .num {
    margin-top: 0.15rem;
    font-family: var(--font-pixel);
    font-size: 0.8125rem;
    color: var(--cyan);
  }
  .step.last .num {
    color: var(--amber-fg);
  }
  @media (min-width: 900px) {
    .num {
      margin-top: 1.1rem;
    }
  }
  .step-title {
    margin-top: 0.2rem;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .step-body {
    margin-top: 0.4rem;
    font-size: 0.95rem;
    color: var(--fg-muted);
    max-width: 22rem;
  }

  /* lights up in turn once the list scrolls in (site.ts adds .is-in); lit by default without JS or motion */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .loop .node,
    :global(.js) .loop .step-title,
    :global(.js) .loop .num {
      transition:
        opacity 0.5s,
        color 0.5s,
        box-shadow 0.6s,
        border-color 0.6s,
        transform 0.6s var(--ease-out-soft);
      transition-delay: calc(var(--i) * var(--stagger));
    }
    :global(.js) .loop:not(.is-in) .node {
      opacity: 0.35;
      transform: scale(0.9);
      box-shadow: 0 0 0 6px var(--bg-2);
      color: var(--fg-subtle);
      --px-accent: var(--fg-subtle);
    }
    :global(.js) .loop:not(.is-in) .step-title,
    :global(.js) .loop:not(.is-in) .num {
      opacity: 0.4;
    }
    :global(.js) .loop .track-fill {
      transition: transform calc(var(--n) * var(--stagger)) linear;
    }
    :global(.js) .loop:not(.is-in) .track-fill {
      transform: scale(0, 1);
    }
    @media (max-width: 899px) {
      :global(.js) .loop:not(.is-in) .track-fill {
        transform: scale(1, 0);
      }
    }
  }
</style>
