---
// Row 04: the local server's home page in a browser frame that tilts back and settles flat as it scrolls in.
import { Picture } from 'astro:assets';
import Lock from '@lucide/astro/icons/lock';
import Row from './Row.astro';
import SectionHead from './SectionHead.astro';
import { productShot } from '../content/site';
---

<Row n="04" labelledby="shot-title">
  <SectionHead kicker={productShot.kicker} title={productShot.title} titleId="shot-title" lead={productShot.body} />
  <div class="rail-pad row-y pt-0!">
    <div class="stage">
      <figure class="frame corners" data-tilt>
        <div class="chrome" aria-hidden="true">
          <span class="dots"><i></i><i></i><i></i></span>
          <span class="url"><Lock class="size-3" />{productShot.url}</span>
          <span class="w-10"></span>
        </div>
        <Picture
          formats={['avif']}
          fallbackFormat="webp"
          src={productShot.image}
          alt={productShot.alt}
          widths={[640, 960, 1280, 1600, 2000]}
          sizes="(min-width: 1200px) 66rem, 92vw"
          quality={70}
          loading="lazy"
          class="block h-auto w-full"
        />
      </figure>
    </div>
  </div>
</Row>

<style>
  .stage {
    perspective: 1600px;
  }
  .frame {
    margin: 0;
    padding: 0.5rem;
    border: 1px solid var(--line);
    background-color: var(--surface);
    transform-origin: 50% 100%;
    box-shadow: 0 60px 120px -60px var(--glow);
  }
  .chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 2.25rem;
    padding-inline: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-subtle);
  }
  .dots {
    display: flex;
    gap: 0.35rem;
    width: 2.5rem;
  }
  .dots i {
    width: 0.55rem;
    height: 0.55rem;
    background: var(--line-strong);
  }
  .url {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.8rem;
    border: 1px solid var(--line);
  }
</style>
