---
import Logo from './Logo.astro';
import GithubMark from './GithubMark.astro';
import { docTypes, footer, repoUrl } from '../content/site';

const links = [
  ...docTypes.items.flatMap((t) => (t.href ? [{ label: t.name, href: t.href }] : [])),
  ...footer.links,
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-x grid gap-10 py-14 md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] md:py-16">
    <div>
      <Logo size={32} />
      <p class="mt-4 max-w-sm text-fg-muted">{footer.tagline}</p>
      <a class="mt-6 inline-flex items-center gap-2 text-fg-muted hover:text-fg" href={repoUrl} rel="noopener">
        <GithubMark class="size-5" />
        <span>andreiverdes/bluedoc</span>
      </a>
    </div>
    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-6 gap-y-3 md:justify-end">
        {
          links.map((l) => (
            <li>
              <a class="text-fg-muted hover:text-fg" href={l.href}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="container-x border-t border-line py-8 text-sm text-fg-subtle">
    <ul class="space-y-1.5">
      {footer.credits.map((c) => <li>{c}</li>)}
    </ul>
    <p class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1">
      <span>© {year} bluedoc</span>
      <span aria-hidden="true">·</span>
      <a class="underline decoration-line-strong underline-offset-4 hover:text-fg" href={footer.licence.href} rel="noopener"
        >{footer.licence.label}</a
      >
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg);
  }
</style>
