---
// The install row: one tab per agent (numbered, down the left on a desktop) and that agent's commands in a
// terminal panel, then what bluedoc needs. The hero has the same tabs in compact form.
import Copy from '@lucide/astro/icons/copy';
import Check from '@lucide/astro/icons/check';
import Row from './Row.astro';
import SectionHead from './SectionHead.astro';
import { install } from '../content/site';

interface Props {
  /** the row's number in the gutter */
  n?: string;
}

const { n } = Astro.props;
---

<Row n={n} id={install.id} labelledby="install-title">
  <SectionHead kicker={install.kicker} title={install.title} titleId="install-title" lead={install.lead} />

  <div class="box" data-tabs>
    <div class="tablist" role="tablist" aria-label="Agent">
      {
        install.tabs.map((t, i) => (
          <button
            type="button"
            role="tab"
            id={`install-tab-${t.id}`}
            aria-controls={`install-panel-${t.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="tab"
          >
            <span class="tab-n">{String(i + 1).padStart(2, '0')}</span>
            {t.label}
          </button>
        ))
      }
    </div>
    <div class="panels">
      {
        install.tabs.map((t, i) => (
          <div
            role="tabpanel"
            id={`install-panel-${t.id}`}
            aria-labelledby={`install-tab-${t.id}`}
            tabindex="0"
            class="panel"
            hidden={i !== 0}
          >
            <div class="term">
              <div class="term-bar">
                <span class="label">{t.label}</span>
                <button
                  type="button"
                  class="copy-btn"
                  data-copy={t.commands.join('\n')}
                  aria-label={`Copy the ${t.label} install ${t.commands.length > 1 ? 'commands' : 'command'}`}
                >
                  <Copy class="i-copy size-4" aria-hidden="true" />
                  <Check class="i-done size-4" aria-hidden="true" />
                </button>
              </div>
              <div class="term-cmds">
                {t.commands.map((c) => (
                  <div class="cmd">
                    <span class="text-brand-fg select-none" aria-hidden="true">
                      $
                    </span>
                    <code>{c}</code>
                  </div>
                ))}
              </div>
            </div>
            <p class="note">{t.note}</p>
          </div>
        ))
      }
    </div>
  </div>

  <div class="needs">
    <span class="label">Needs</span>
    <ul class="needs-list">
      {install.requirements.map((r) => <li>{r}</li>)}
    </ul>
  </div>
</Row>

<style>
  .box {
    display: grid;
    border-top: 1px solid var(--rail);
  }
  @media (min-width: 900px) {
    .box {
      grid-template-columns: 15rem minmax(0, 1fr);
    }
  }
  .tablist {
    display: flex;
    overflow-x: auto;
    scrollbar-width: none;
    border-bottom: 1px solid var(--rail);
  }
  @media (min-width: 900px) {
    .tablist {
      flex-direction: column;
      overflow: visible;
      border-bottom: 0;
      border-right: 1px solid var(--rail);
    }
  }
  .tab {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.9rem;
    height: 3.25rem;
    padding-inline: 1.25rem;
    border-right: 1px solid var(--rail);
    font-size: 0.9375rem;
    color: var(--fg-muted);
    white-space: nowrap;
    cursor: pointer;
    transition:
      color 0.15s,
      background-color 0.15s;
  }
  @media (min-width: 900px) {
    .tab {
      border-right: 0;
      border-bottom: 1px solid var(--rail);
    }
  }
  .tab:hover {
    color: var(--fg);
  }
  .tab:focus-visible {
    outline-offset: -2px;
  }
  .tab-n {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--fg-subtle);
  }
  .tab[aria-selected='true'] {
    color: var(--fg);
    background: var(--surface);
    box-shadow: inset 2px 0 0 var(--brand-fg);
  }
  .tab[aria-selected='true'] .tab-n {
    color: var(--brand-fg);
  }
  .panel {
    padding: clamp(1.25rem, 3vw, 2.5rem);
  }
  .panel:focus-visible {
    outline-offset: -2px;
  }
  .term {
    border: 1px solid var(--line-strong);
    background: var(--surface);
  }
  .term-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.25rem 0.35rem 0.25rem 1rem;
    border-bottom: 1px solid var(--line);
  }
  .term-cmds {
    display: grid;
    gap: 0.55rem;
    padding: 1.1rem 1rem 1.2rem;
    font-family: var(--font-mono);
    font-size: clamp(0.78rem, 0.74rem + 0.2vw, 0.875rem);
  }
  .cmd {
    display: flex;
    gap: 0.75rem;
    /* long commands wrap at any character rather than scroll, so the whole command stays readable on a phone */
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .note {
    max-width: 44rem;
    margin-top: 1.1rem;
    font-size: 0.9375rem;
    color: var(--fg-muted);
  }
  .needs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding: 1.1rem clamp(1.25rem, 3.5vw, 3rem);
    border-top: 1px solid var(--rail);
  }
  .needs-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.875rem;
    color: var(--fg-muted);
  }
  .needs-list li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .needs-list li::before {
    content: '';
    width: 5px;
    height: 5px;
    background: var(--brand-fg);
  }
</style>
