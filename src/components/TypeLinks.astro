---
// The other doc types, at the foot of a type page: a card for each type with its own page, then the rest by name
// with a link to the home page's Doc types section.
import { Picture } from 'astro:assets';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import { docTypes, nav } from '../content/site';
import { typePageLabels as labels } from '../content/types';

interface Props {
  /** the current page's type id, left out of the list */
  current: string;
}

const { current } = Astro.props;
const others = docTypes.items.filter((t) => t.id !== current);
const linked = others.filter((t) => t.href);
const unlinked = others.filter((t) => !t.href);
---

<section class="section-y" aria-labelledby="other-types-title">
  <div class="container-x">
    <div class="max-w-2xl" data-reveal>
      <p class="kicker">{labels.otherKicker}</p>
      <h2 id="other-types-title" class="h2 mt-4">{labels.otherTitle}</h2>
    </div>

    <ul class="mt-10 grid gap-4 sm:mt-12 sm:grid-cols-2 lg:gap-5">
      {
        linked.map((t, i) => (
          <li class="type-card card" data-reveal style={`--reveal-i:${i}`}>
            <a href={t.href} class="block h-full">
              <div class="shot">
                <Picture
                  formats={['avif']}
                  fallbackFormat="webp"
                  src={t.image}
                  alt=""
                  widths={[400, 560, 720, 960]}
                  sizes="(min-width: 1024px) 36rem, (min-width: 640px) 50vw, 94vw"
                  quality={65}
                  loading="lazy"
                  class="shot-img"
                />
              </div>
              <div class="flex items-start justify-between gap-4 p-6">
                <div>
                  <h3 class="text-xl font-semibold">{t.name}</h3>
                  <p class="mt-1.5 text-fg-muted">{t.pitch}</p>
                </div>
                <ArrowRight class="arrow mt-1 size-5 flex-none text-cyan" aria-hidden="true" />
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    {
      unlinked.length > 0 && (
        <p class="mt-8 text-fg-muted" data-reveal>
          {unlinked.map((t) => t.name).join(', ')}:{' '}
          <a class="text-fg underline decoration-line-strong underline-offset-4 hover:decoration-cyan" href={nav.typesMenu.all.href}>
            {labels.otherAll}
          </a>
          .
        </p>
      )
    }
  </div>
</section>

<style>
  .type-card {
    overflow: hidden;
    transition:
      transform 0.35s var(--ease-out-soft),
      border-color 0.35s;
  }
  .type-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in oklab, var(--brand-fg) 55%, transparent);
  }
  .type-card a:focus-visible {
    outline-offset: -3px;
    border-radius: 1.25rem;
  }
  .shot {
    height: clamp(11rem, 8rem + 8vw, 16rem);
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: var(--bg-2);
  }
  .shot-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0%;
  }
  .arrow {
    transition: translate 0.25s var(--ease-out-soft);
  }
  .type-card:hover .arrow {
    translate: 4px 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .type-card:hover {
      transform: none;
    }
  }
</style>
