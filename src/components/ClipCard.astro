---
// A clip with its title and 1–2 sentences under it, as one cell of a ruled grid (.clip-grid.fill-grid.ruled in
// global.css, `style` from ruledGrid): the shared strip on a type page and the groups on /features/.
import Clip from './Clip.astro';
import type { ClipCopy } from '../content/types';

interface Props {
  item: ClipCopy;
  /** the reveal stagger, from 0 */
  index: number;
  /** the cell's spans and rules, from ruledGrid (src/lib/ruled-grid.ts) */
  style: string;
}

const { item, index, style } = Astro.props;
---

<li data-reveal={String(index)} style={style}>
  <Clip name={item.clip} label={item.shows} title={item.title} zoom />
  <h3 class="mt-5 text-lg font-medium tracking-tight">{item.title}</h3>
  <p class="mt-1.5 text-[0.9375rem] text-fg-muted">{item.body}</p>
</li>
