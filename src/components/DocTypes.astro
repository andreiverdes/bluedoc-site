---
// Row 06: the eight doc types as one viewer. A row of tabs (pixel icon and name) under a stage that shows the
// picked type's screenshot, pitch and bullets. Tabs follow the WAI-ARIA pattern (site.ts); with motion they move
// on by themselves every 6 s while in view, until the reader picks one (motion.ts, [data-autoplay]).
import { Picture } from 'astro:assets';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Row from './Row.astro';
import SectionHead from './SectionHead.astro';
import PixelIcon from './PixelIcon.astro';
import { docTypes } from '../content/site';

const total = String(docTypes.items.length).padStart(2, '0');
---

<Row n="06" id={docTypes.id} labelledby="types-title">
  <SectionHead kicker={docTypes.kicker} title={docTypes.title} titleId="types-title" lead={docTypes.lead} />

  <div class="viewer" data-tabs data-autoplay="6">
    <div class="stage">
      {
        docTypes.items.map((t, i) => (
          <div role="tabpanel" id={`dt-panel-${t.id}`} aria-labelledby={`dt-tab-${t.id}`} tabindex="0" class="panel" hidden={i !== 0}>
            <div class="panel-text">
              <span class="label">
                {String(i + 1).padStart(2, '0')} / {total}
              </span>
              <h3 class="h3 mt-4">{t.name}</h3>
              <p class="mt-3 text-fg-muted">{t.pitch}</p>
              <ul class="bullets">
                {t.bullets.map((b) => (
                  <li>
                    <span class="tick" aria-hidden="true" />
                    {b}
                  </li>
                ))}
              </ul>
              <a class="link-arrow mt-auto" href={t.href}>
                Open the {t.name} page
                <ArrowUpRight class="size-4" aria-hidden="true" />
              </a>
            </div>
            <figure class="shot">
              <Picture
                formats={['avif']}
                fallbackFormat="webp"
                src={t.image}
                alt={t.alt}
                widths={[640, 960, 1280, 1600]}
                sizes="(min-width: 1024px) 44rem, 92vw"
                quality={70}
                loading="lazy"
                class="block h-full w-full object-cover object-top"
              />
            </figure>
          </div>
        ))
      }
    </div>

    <div class="tabs" role="tablist" aria-label={docTypes.kicker}>
      {
        docTypes.items.map((t, i) => (
          <button
            type="button"
            role="tab"
            id={`dt-tab-${t.id}`}
            aria-controls={`dt-panel-${t.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="tab"
          >
            <PixelIcon name={t.id} size={22} class="tab-icon" />
            <span>{t.name}</span>
            <span class="tab-progress" data-progress aria-hidden="true" />
          </button>
        ))
      }
    </div>
  </div>
</Row>

<style>
  .viewer {
    border-top: 1px solid var(--rail);
  }
  .panel {
    display: grid;
  }
  .panel:focus-visible {
    outline-offset: -2px;
  }
  @media (min-width: 1024px) {
    .panel {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
      min-height: 31rem;
    }
  }
  :global(.motion) .panel:not([hidden]) {
    animation: panel-in 0.6s var(--ease-out-soft);
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      translate: 0 10px;
    }
  }
  .panel-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1.25rem, 3.5vw, 3rem);
  }
  .bullets {
    display: grid;
    gap: 0.7rem;
    margin-block: 1.75rem 2rem;
    font-size: 0.9375rem;
  }
  .bullets li {
    display: flex;
    gap: 0.75rem;
  }
  .tick {
    flex: none;
    width: 7px;
    height: 7px;
    margin-top: 0.5rem;
    background: var(--brand-fg);
  }
  .shot {
    margin: 0;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-top: 1px solid var(--rail);
    background: var(--surface);
  }
  @media (min-width: 1024px) {
    .shot {
      aspect-ratio: auto;
      border-top: 0;
      border-left: 1px solid var(--rail);
    }
  }

  .tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--rail);
  }
  @media (min-width: 1024px) {
    .tabs {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }
  }
  .tab {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.55rem;
    padding: 1.1rem 0.5rem 1.2rem;
    border-right: 1px solid var(--rail);
    border-bottom: 1px solid var(--rail);
    margin-bottom: -1px;
    font-size: 0.8125rem;
    color: var(--fg-subtle);
    cursor: pointer;
    transition:
      color 0.15s,
      background-color 0.15s;
  }
  .tab:last-child {
    border-right: 0;
  }
  .tab:hover {
    color: var(--fg);
  }
  .tab:focus-visible {
    outline-offset: -2px;
  }
  .tab :global(.tab-icon) {
    --px-accent: currentColor;
  }
  .tab[aria-selected='true'] {
    color: var(--fg);
    background: var(--surface);
  }
  .tab[aria-selected='true'] :global(.tab-icon) {
    --px-accent: var(--brand-fg);
  }
  /* the line along the top of the picked tab; with autoplay it fills over the tab's 6 s */
  .tab-progress {
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--brand-fg);
    transform-origin: left;
    transform: scaleX(0);
  }
  .tab[aria-selected='true'] .tab-progress {
    transform: scaleX(1);
  }
  :global(.motion) [data-autoplay] .tab-progress {
    transform: scaleX(0);
  }
</style>
