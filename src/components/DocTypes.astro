---
import { Picture } from 'astro:assets';
import Check from '@lucide/astro/icons/check';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import { docTypes } from '../content/site';

// Bento spans on a 6-column grid from 1024 px: wide, narrow / narrow, wide / halves / halves. On the 2-column grid
// (640–1023 px) the last card of an odd count spans both columns.
const spans = ['lg:col-span-4', 'lg:col-span-2', 'lg:col-span-2', 'lg:col-span-4', 'lg:col-span-3', 'lg:col-span-3', 'lg:col-span-3', 'lg:col-span-3'];
const oddLast = docTypes.items.length % 2 === 1 ? docTypes.items.length - 1 : -1;
---

<section id={docTypes.id} class="section-y" aria-labelledby="types-title">
  <div class="container-x">
    <div class="max-w-2xl" data-reveal>
      <p class="kicker">{docTypes.kicker}</p>
      <h2 id="types-title" class="h2 mt-4">{docTypes.title}</h2>
      <p class="lead mt-5">{docTypes.lead}</p>
    </div>

    <ul class="mt-12 grid gap-4 sm:mt-16 sm:grid-cols-2 lg:grid-cols-6 lg:gap-5">
      {
        docTypes.items.map((t, i) => (
          <li
            class:list={['bento card', spans[i % spans.length], { 'sm:max-lg:col-span-2': i === oddLast }]}
            data-reveal
            style={`--reveal-i:${i % 3}`}
          >
            <div class="shot">
              <Picture
                formats={['avif']}
                fallbackFormat="webp"
                src={t.image}
                alt={t.alt}
                widths={[400, 560, 720, 960, 1200]}
                sizes={
                  spans[i % spans.length] === 'lg:col-span-4'
                    ? '(min-width: 1024px) 50rem, (min-width: 640px) 50vw, 94vw'
                    : '(min-width: 1024px) 38rem, (min-width: 640px) 50vw, 94vw'
                }
                quality={70}
                loading="lazy"
                class="shot-img"
              />
              <span class="scan" aria-hidden="true" />
            </div>
            <div class="flex flex-1 flex-col p-6 sm:p-7">
              <div class="flex items-center gap-3">
                <h3 class="text-xl font-semibold">
                  <a href={t.href} class="card-link">
                    {t.name}
                  </a>
                </h3>
                <code class="tag">{t.tag}</code>
              </div>
              <p class="mt-2 text-fg-muted">{t.pitch}</p>
              <ul class="mt-4 space-y-2 text-[0.95rem]">
                {t.bullets.map((b) => (
                  <li class="flex gap-2.5">
                    <Check class="mt-1 size-4 flex-none text-cyan" aria-hidden="true" />
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
              <span class="more" aria-hidden="true">
                See the {t.name} page
                <ArrowRight class="more-arrow size-4" />
              </span>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .bento {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition:
      transform 0.35s var(--ease-out-soft),
      box-shadow 0.35s,
      border-color 0.35s;
  }
  .bento:hover {
    transform: translateY(-6px);
    border-color: color-mix(in oklab, var(--brand-fg) 55%, transparent);
    box-shadow:
      var(--shadow),
      0 30px 70px -30px var(--glow);
  }
  .shot {
    position: relative;
    height: clamp(13rem, 9rem + 10vw, 19rem);
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: var(--bg-2);
  }
  .shot-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0%;
    transition: transform 0.6s var(--ease-out-soft);
  }
  .bento:hover .shot-img {
    transform: scale(1.03);
  }

  /* scanlines plus one light band sweeping down on hover */
  .scan {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background:
      linear-gradient(
        to bottom,
        transparent 0%,
        rgb(95 212 255 / 0.22) 48%,
        rgb(255 255 255 / 0.35) 50%,
        rgb(95 212 255 / 0.22) 52%,
        transparent 100%
      )
        0 -100% / 100% 40% no-repeat,
      repeating-linear-gradient(to bottom, rgb(0 0 0 / 0.16) 0 1px, transparent 1px 3px);
    transition: opacity 0.3s;
  }
  .bento:hover .scan {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .bento:hover .scan {
      animation: sweep 1.1s var(--ease-out-soft) both;
    }
  }
  @keyframes sweep {
    from {
      background-position:
        0 -60%,
        0 0;
    }
    to {
      background-position:
        0 160%,
        0 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bento,
    .bento:hover,
    .bento:hover .shot-img {
      transform: none;
    }
  }

  .tag {
    padding: 0.1rem 0.5rem;
    border-radius: 0.4rem;
    border: 1px solid var(--line);
    background: var(--line);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-muted);
  }
  /* a card with a page: the title's link covers the whole card */
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }
  .card-link:focus-visible {
    outline: none;
  }
  .bento:has(.card-link:focus-visible) {
    outline: 2px solid var(--cyan);
    outline-offset: 3px;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 1.25rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--brand-fg);
  }
  .more-arrow {
    transition: translate 0.25s var(--ease-out-soft);
  }
  .bento:hover .more-arrow {
    translate: 4px 0;
  }
</style>
