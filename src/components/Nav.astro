---
import Menu from '@lucide/astro/icons/menu';
import Sun from '@lucide/astro/icons/sun';
import Moon from '@lucide/astro/icons/moon';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import Logo from './Logo.astro';
import GithubMark from './GithubMark.astro';
import { docTypes, nav } from '../content/site';
import { base } from '../lib/paths';

const onHome = Astro.url.pathname === base;
// The Doc types menu: every type's page, then the Features page; the link to the current page is marked.
const isCurrent = (href: string) => Astro.url.pathname === href;
const typePages = docTypes.items.map((t) => ({ label: t.name, pitch: t.pitch, href: t.href, current: isCurrent(t.href) }));
const featuresPage = { ...nav.typesMenu.features, current: isCurrent(nav.typesMenu.features.href) };
const [firstLink, ...restLinks] = nav.links;
---

<div data-nav-sentinel aria-hidden="true" class="pointer-events-none absolute top-0 left-0 h-6 w-px"></div>
<header class="site-nav fixed inset-x-0 top-0 z-50" data-nav>
  <nav aria-label="Main" class="container-x flex h-16 items-center gap-4">
    <a href={onHome ? '#top' : base} class="logo-link -ml-1 rounded-lg p-1" aria-label={onHome ? 'bluedoc, back to top' : 'bluedoc home'}>
      <Logo size={30} />
    </a>

    <ul class="ml-auto hidden items-center gap-1 lg:flex">
      <li>
        <a class="nav-link" href={firstLink.href}>{firstLink.label}</a>
      </li>
      <li>
        <details class="types-menu relative" data-nav-types>
          <summary class="nav-link types-summary">
            {nav.typesMenu.label}
            <ChevronDown class="types-chevron size-4" aria-hidden="true" />
          </summary>
          <div class="types-panel card">
            <ul class="types-list">
              {
                typePages.map((t) => (
                  <li>
                    <a class="types-item" href={t.href} aria-current={t.current ? 'page' : undefined}>
                      <span class="font-semibold text-fg">{t.label}</span>
                      <span class="text-sm text-fg-muted">{t.pitch}</span>
                    </a>
                  </li>
                ))
              }
              <li>
                <a class="types-item types-features" href={featuresPage.href} aria-current={featuresPage.current ? 'page' : undefined}>
                  <span class="font-semibold text-fg">{featuresPage.label}</span>
                  <span class="text-sm text-fg-muted">{featuresPage.pitch}</span>
                </a>
              </li>
            </ul>
            <a class="types-all" href={nav.typesMenu.all.href}>{nav.typesMenu.all.label}</a>
          </div>
        </details>
      </li>
      {
        restLinks.map((l) => (
          <li>
            <a class="nav-link" href={l.href}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="ml-auto flex items-center gap-1 lg:ml-2">
      <a class="nav-link inline-flex items-center gap-2" href={nav.github.href} rel="noopener">
        <GithubMark class="size-[18px]" />
        <span class="max-sm:sr-only">{nav.github.label}</span>
      </a>
      <button type="button" class="icon-btn" data-theme-toggle aria-label="Switch to light theme">
        <Sun class="i-sun size-[18px]" aria-hidden="true" />
        <Moon class="i-moon size-[18px]" aria-hidden="true" />
      </button>
      <details class="nav-menu relative lg:hidden" data-nav-menu>
        <summary class="icon-btn" aria-label="Menu">
          <Menu class="size-5" aria-hidden="true" />
        </summary>
        <div class="nav-menu-panel card absolute top-12 right-0 max-h-[calc(100dvh-5rem)] w-64 overflow-y-auto p-2">
          <ul>
            {
              nav.links.map((l) => (
                <li>
                  <a class="block rounded-lg px-3 py-2.5 text-fg-muted hover:bg-line hover:text-fg" href={l.href}>
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <p id="nav-types-heading" class="menu-group-label">{nav.typesMenu.label}</p>
          <ul aria-labelledby="nav-types-heading">
            {
              typePages.map((t) => (
                <li>
                  <a
                    class="block rounded-lg px-3 py-2.5 text-fg-muted hover:bg-line hover:text-fg aria-[current=page]:text-fg"
                    href={t.href}
                    aria-current={t.current ? 'page' : undefined}
                  >
                    {t.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a
                class="block rounded-lg px-3 py-2.5 text-fg-muted hover:bg-line hover:text-fg aria-[current=page]:text-fg"
                href={featuresPage.href}
                aria-current={featuresPage.current ? 'page' : undefined}
              >
                {featuresPage.label}
              </a>
            </li>
            <li>
              <a class="block rounded-lg px-3 py-2.5 text-fg-muted hover:bg-line hover:text-fg" href={nav.typesMenu.all.href}>
                {nav.typesMenu.all.label}
              </a>
            </li>
          </ul>
        </div>
      </details>
    </div>
  </nav>
</header>

<style>
  .site-nav {
    transition:
      background-color 0.3s,
      box-shadow 0.3s,
      backdrop-filter 0.3s;
  }
  .site-nav.is-scrolled {
    background: color-mix(in oklab, var(--bg) 72%, transparent);
    backdrop-filter: blur(16px) saturate(1.5);
    -webkit-backdrop-filter: blur(16px) saturate(1.5);
    box-shadow: 0 1px 0 var(--line);
  }
  .site-nav:not(.is-scrolled)::before {
    content: '';
    position: absolute;
    inset: 0 0 -24px;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(to bottom, color-mix(in oklab, var(--bg) 55%, transparent), transparent);
  }
  .nav-link {
    display: inline-flex;
    height: 2.5rem;
    align-items: center;
    padding-inline: 0.8rem;
    border-radius: 0.6rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--fg-muted);
    transition:
      color 0.15s,
      background-color 0.15s;
  }
  .nav-link:hover {
    color: var(--fg);
    background: var(--line);
  }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.6rem;
    color: var(--fg-muted);
    cursor: pointer;
    list-style: none;
    transition:
      color 0.15s,
      background-color 0.15s;
  }
  .icon-btn::-webkit-details-marker {
    display: none;
  }
  .icon-btn:hover {
    color: var(--fg);
    background: var(--line);
  }
  :global([data-theme='dark'] .i-moon),
  :global([data-theme='light'] .i-sun) {
    display: none;
  }
  .nav-menu-panel {
    background: var(--surface);
  }
  .menu-group-label {
    margin: 0.5rem 0.75rem 0.25rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-pixel);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cyan);
  }

  /* Doc types: a disclosure (details/summary), so Enter and Space open it with no script; site.ts closes it on
     Escape, on a click outside and when focus leaves it. */
  .types-summary {
    gap: 0.3rem;
    cursor: pointer;
    list-style: none;
  }
  .types-summary::-webkit-details-marker {
    display: none;
  }
  .types-chevron {
    transition: transform 0.2s var(--ease-out-soft);
  }
  .types-menu[open] .types-summary {
    color: var(--fg);
    background: var(--line);
  }
  .types-menu[open] .types-chevron {
    transform: rotate(180deg);
  }
  /* the seven types and the Features page in two columns, then the link to the home page's list */
  .types-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 50%;
    translate: -50% 0;
    width: 40rem;
    padding: 0.5rem;
    background: var(--surface);
  }
  .types-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.15rem;
  }
  .types-item {
    display: grid;
    align-content: start;
    gap: 0.15rem;
    height: 100%;
    padding: 0.7rem 0.85rem;
    border-radius: 0.75rem;
    line-height: 1.4;
    transition: background-color 0.15s;
  }
  .types-item:hover,
  .types-item[aria-current='page'] {
    background: var(--line);
  }
  /* the Features page: the eighth cell, set apart by a cyan edge */
  .types-features {
    box-shadow: inset 2px 0 0 var(--cyan);
    border-radius: 0 0.75rem 0.75rem 0;
  }
  .types-all {
    display: block;
    margin-top: 0.35rem;
    padding: 0.65rem 0.85rem 0.45rem;
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
    color: var(--fg-muted);
  }
  .types-all:hover {
    color: var(--fg);
  }
</style>
