---
import Menu from '@lucide/astro/icons/menu';
import Sun from '@lucide/astro/icons/sun';
import Moon from '@lucide/astro/icons/moon';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import Logo from './Logo.astro';
import GithubMark from './GithubMark.astro';
import PixelIcon from './PixelIcon.astro';
import { docTypes, nav } from '../content/site';
import { base } from '../lib/paths';

const onHome = Astro.url.pathname === base;
// The Doc types menu: every type's page, then the Features page; the link to the current page is marked.
const isCurrent = (href: string) => Astro.url.pathname === href;
const typePages = docTypes.items.map((t) => ({ id: t.id, label: t.name, pitch: t.pitch, href: t.href, current: isCurrent(t.href) }));
const featuresPage = { ...nav.typesMenu.features, current: isCurrent(nav.typesMenu.features.href) };
const [firstLink, ...restLinks] = nav.links;
---

<div data-nav-sentinel aria-hidden="true" class="pointer-events-none absolute top-0 left-0 h-6 w-px"></div>
<header class="site-nav fixed inset-x-0 top-0 z-50" data-nav>
  <nav aria-label="Main" class="rail nav-rail">
    <a href={onHome ? '#top' : base} class="logo-link" aria-label={onHome ? 'bluedoc, back to top' : 'bluedoc home'}>
      <Logo size={26} />
    </a>

    <ul class="nav-group">
      <li>
        <a class="nav-link" href={firstLink.href}>{firstLink.label}</a>
      </li>
      <li>
        <details class="types-menu relative" data-nav-types>
          <summary class="nav-link types-summary">
            {nav.typesMenu.label}
            <ChevronDown class="types-chevron size-3.5" aria-hidden="true" />
          </summary>
          <div class="types-panel">
            <ul class="types-list">
              {
                typePages.map((t) => (
                  <li>
                    <a class="types-item" href={t.href} aria-current={t.current ? 'page' : undefined}>
                      <PixelIcon name={t.id} size={20} class="types-icon" />
                      <span class="grid gap-0.5">
                        <span class="font-medium text-fg">{t.label}</span>
                        <span class="text-[0.8125rem] leading-snug text-fg-muted">{t.pitch}</span>
                      </span>
                    </a>
                  </li>
                ))
              }
              <li>
                <a class="types-item types-features" href={featuresPage.href} aria-current={featuresPage.current ? 'page' : undefined}>
                  <PixelIcon name="spark" size={20} class="types-icon" />
                  <span class="grid gap-0.5">
                    <span class="font-medium text-fg">{featuresPage.label}</span>
                    <span class="text-[0.8125rem] leading-snug text-fg-muted">{featuresPage.pitch}</span>
                  </span>
                </a>
              </li>
            </ul>
            <a class="types-all label" href={nav.typesMenu.all.href}>{nav.typesMenu.all.label} ↓</a>
          </div>
        </details>
      </li>
      {
        restLinks.map((l) => (
          <li>
            <a class="nav-link" href={l.href}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="nav-end">
      <button type="button" class="icon-btn" data-theme-toggle aria-label="Switch to light theme">
        <Sun class="i-sun size-4" aria-hidden="true" />
        <Moon class="i-moon size-4" aria-hidden="true" />
      </button>
      <a class="gh-btn" href={nav.github.href} rel="noopener">
        <GithubMark class="size-4" />
        <span class="max-sm:sr-only">{nav.github.label}</span>
      </a>
      <details class="nav-menu relative lg:hidden" data-nav-menu>
        <summary class="icon-btn" aria-label="Menu">
          <Menu class="size-4" aria-hidden="true" />
        </summary>
        <div class="nav-menu-panel">
          <ul>
            {
              nav.links.map((l) => (
                <li>
                  <a class="menu-link" href={l.href}>
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <p id="nav-types-heading" class="menu-group-label label">{nav.typesMenu.label}</p>
          <ul aria-labelledby="nav-types-heading">
            {
              typePages.map((t) => (
                <li>
                  <a class="menu-link" href={t.href} aria-current={t.current ? 'page' : undefined}>
                    {t.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a class="menu-link" href={featuresPage.href} aria-current={featuresPage.current ? 'page' : undefined}>
                {featuresPage.label}
              </a>
            </li>
            <li>
              <a class="menu-link" href={nav.typesMenu.all.href}>
                {nav.typesMenu.all.label}
              </a>
            </li>
          </ul>
        </div>
      </details>
    </div>
  </nav>
</header>

<style>
  .site-nav {
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.3s,
      border-color 0.3s,
      backdrop-filter 0.3s;
  }
  .site-nav.is-scrolled {
    background: color-mix(in oklab, var(--bg) 78%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    border-bottom-color: var(--rail);
  }
  .nav-rail {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 4rem;
    padding-inline: clamp(1rem, 2.5vw, 1.75rem);
  }
  .logo-link {
    display: inline-flex;
    padding: 0.25rem;
    margin-left: -0.25rem;
  }

  /* the boxed group in the middle: mono caps, hairline dividers */
  .nav-group {
    display: none;
    margin-inline: auto;
    border: 1px solid var(--line-strong);
  }
  @media (min-width: 1024px) {
    .nav-group {
      display: flex;
    }
  }
  .nav-group > li + li {
    border-left: 1px solid var(--line);
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    height: 2.25rem;
    padding-inline: 0.95rem;
    font-family: var(--font-mono);
    font-size: 0.71875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
    transition:
      color 0.15s,
      background-color 0.15s;
  }
  .nav-link:hover {
    color: var(--fg);
    background: var(--line);
  }

  .nav-end {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }
  @media (min-width: 1024px) {
    .nav-end {
      margin-left: 0;
    }
  }
  .icon-btn,
  .gh-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: 2.25rem;
    min-width: 2.25rem;
    border: 1px solid var(--line-strong);
    color: var(--fg-muted);
    cursor: pointer;
    list-style: none;
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  .gh-btn {
    padding-inline: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.71875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg);
  }
  .icon-btn::-webkit-details-marker {
    display: none;
  }
  .icon-btn:hover,
  .gh-btn:hover {
    color: var(--fg);
    border-color: var(--brand-fg);
  }
  :global([data-theme='dark'] .i-moon),
  :global([data-theme='light'] .i-sun) {
    display: none;
  }

  .nav-menu-panel,
  .types-panel {
    background: var(--surface);
    border: 1px solid var(--line-strong);
    box-shadow: 0 24px 60px -24px rgb(0 0 0 / 0.45);
  }
  .nav-menu-panel {
    position: absolute;
    top: 3rem;
    right: 0;
    width: 16rem;
    max-height: calc(100dvh - 5rem);
    overflow-y: auto;
    padding: 0.35rem;
  }
  .menu-link {
    display: block;
    padding: 0.6rem 0.75rem;
    color: var(--fg-muted);
  }
  .menu-link:hover,
  .menu-link[aria-current='page'] {
    color: var(--fg);
    background: var(--line);
  }
  .menu-group-label {
    margin: 0.4rem 0.75rem 0.2rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--line);
  }

  /* Doc types: a disclosure (details/summary), so Enter and Space open it with no script; site.ts closes it on
     Escape, on a click outside and when focus leaves it. */
  .types-summary {
    cursor: pointer;
    list-style: none;
  }
  .types-summary::-webkit-details-marker {
    display: none;
  }
  .types-chevron {
    transition: transform 0.2s var(--ease-out-soft);
  }
  .types-menu[open] .types-summary {
    color: var(--fg);
    background: var(--line);
  }
  .types-menu[open] .types-chevron {
    transform: rotate(180deg);
  }
  .types-panel {
    position: absolute;
    top: calc(100% + 0.6rem);
    left: 50%;
    translate: -50% 0;
    width: 42rem;
  }
  .types-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .types-list > li {
    border-bottom: 1px solid var(--line);
  }
  .types-list > li:nth-child(odd) {
    border-right: 1px solid var(--line);
  }
  .types-item {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    height: 100%;
    padding: 0.85rem 1rem;
    line-height: 1.4;
    transition: background-color 0.15s;
  }
  .types-item:hover,
  .types-item[aria-current='page'] {
    background: var(--brand-tint);
  }
  .types-item :global(.types-icon) {
    flex: none;
    margin-top: 0.1rem;
    color: var(--fg-muted);
    --px-accent: var(--brand-fg);
  }
  .types-item:hover :global(.types-icon) {
    color: var(--fg);
  }
  .types-all {
    display: block;
    padding: 0.8rem 1rem;
  }
  .types-all:hover {
    color: var(--fg);
  }
</style>
