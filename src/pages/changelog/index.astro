---
// The changelog (/changelog/): the hero, then every post newest first as a card (its hero clip's poster, date,
// version, title and summary), the install band and the footer. Posts are MDX in src/content/changelog/
// (src/content.config.ts); copy in atlasChangelog (src/content/atlas.ts).
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import '../../styles/atlas.css';
import '../../styles/changelog.css';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/atlas/Nav.astro';
import Cta from '../../components/atlas/Cta.astro';
import Footer from '../../components/atlas/Footer.astro';
import PixelIcon from '../../components/PixelIcon.astro';
import PixelSky from '../../components/PixelSky.astro';
import { atlasChangelog as c } from '../../content/atlas';
import { clipSize, formatDate, getPosts, isoDate, postHref } from '../../lib/changelog';
import { base } from '../../lib/paths';

// a post's card shows its hero clip's poster, when the post has a hero and the poster is recorded
const posts = (await getPosts()).map((post) => {
  const hero = post.data.hero;
  const poster = hero && existsSync(join(process.cwd(), 'public', 'clips', `${hero}.poster.webp`)) ? { src: `${base}clips/${hero}.poster.webp`, ...clipSize(hero) } : undefined;
  return { post, poster };
});
---

<Base title={c.metaTitle} description={c.metaDescription}>
  <Nav />
  <main id="main">
    <section id="top" class="av-hero changelog-hero" aria-labelledby="changelog-title">
      <div class="av-grid-bg"></div>
      <PixelSky class="av-sky" seed={41} count={100} />
      <div class="av-wrap av-hero-copy">
        <p class="av-kicker enter"><PixelIcon name="spark" size={14} />{c.kicker}</p>
        <h1 id="changelog-title" class="av-h1 enter" style="--d:0.08s">{c.title}</h1>
        <p class="lead av-sub enter" style="--d:0.16s">{c.lead}</p>
      </div>
    </section>

    <section class="av-section changelog-list-section" aria-label={c.listLabel}>
      <ul class="av-wrap changelog-list">
        {
          posts.map(({ post, poster }, i) => (
            <li class="enter" style={`--d:${0.24 + Math.min(i, 3) * 0.08}s`}>
              <a class="av-card changelog-card" href={postHref(post)}>
                <span class="changelog-card-art av-art" aria-hidden="true">
                  {poster ? (
                    <img src={poster.src} alt="" width={poster.width} height={poster.height} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
                  ) : (
                    <PixelIcon name="spark" size={40} />
                  )}
                </span>
                <span class="changelog-card-body">
                  <span class="changelog-meta">
                    <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
                    {post.data.version && <span class="av-chip">v{post.data.version}</span>}
                  </span>
                  <span class="changelog-card-title">{post.data.title}</span>
                  <span class="changelog-card-text">{post.data.summary}</span>
                  <ArrowRight class="changelog-card-arrow size-4" aria-hidden="true" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <Cta />
  </main>
  <Footer />
</Base>
