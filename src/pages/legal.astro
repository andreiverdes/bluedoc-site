---
// /legal/: the licence, what bluedoc and this site store (nothing that leaves your machine or browser), and the
// credits for the fonts, icons and art. Copy in `legal` in src/content/site.ts.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { legal } from '../content/site';
import { inlineMd } from '../lib/inline-code';
---

<Base title={legal.metaTitle} description={legal.metaDescription}>
  <Nav />
  <main id="main" class="legal">
    <div class="container-x">
      <header class="max-w-2xl">
        <p class="kicker">{legal.kicker}</p>
        <h1 class="h2 mt-4">{legal.title}</h1>
        <p class="lead mt-5">{legal.lead}</p>
      </header>
      <div class="sections">
        {
          legal.sections.map((s) => (
            <section id={s.id} aria-labelledby={`${s.id}-title`}>
              <h2 id={`${s.id}-title`} class="sec-title">
                {s.title}
              </h2>
              <div class="sec-body">
                {s.body.map((p) => (
                  <p set:html={inlineMd(p)} />
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .legal {
    padding-block: clamp(7rem, 5rem + 5vw, 9rem) clamp(4rem, 3rem + 3vw, 6rem);
  }
  .sections {
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
    display: grid;
    gap: 0;
    max-width: 52rem;
  }
  section {
    display: grid;
    gap: 0.75rem 3rem;
    padding-block: 2rem;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 768px) {
    section {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }
  .sec-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--fg);
  }
  .sec-body {
    display: grid;
    gap: 1rem;
    color: var(--fg-muted);
    line-height: 1.65;
  }
  .sec-body :global(strong) {
    color: var(--fg);
    font-weight: 600;
  }
  .sec-body :global(a) {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
  }
  .sec-body :global(a:hover) {
    text-decoration-color: currentColor;
  }
  .sec-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
  }
</style>
