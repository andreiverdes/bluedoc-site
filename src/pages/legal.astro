---
// /legal/: the licence, what bluedoc and this site store (nothing that leaves your machine or browser), and the
// credits for the fonts, icons and art, one ruled row each. Copy in `legal` in src/content/site.ts.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Row from '../components/Row.astro';
import SectionHead from '../components/SectionHead.astro';
import { legal } from '../content/site';
import { inlineMd } from '../lib/inline-code';
---

<Base title={legal.metaTitle} description={legal.metaDescription}>
  <Nav />
  <main id="main" class="pt-16">
    <Row n="01" labelledby="legal-title">
      <SectionHead kicker={legal.kicker} title={legal.title} titleId="legal-title" lead={legal.lead} h1 />
    </Row>
    {
      legal.sections.map((s, i) => (
        <Row n={String(i + 2).padStart(2, '0')} id={s.id} labelledby={`${s.id}-title`}>
          <div class="sec rail-pad">
            <h2 id={`${s.id}-title`} class="h3">
              {s.title}
            </h2>
            <div class="sec-body">
              {s.body.map((p) => (
                <p set:html={inlineMd(p)} />
              ))}
            </div>
          </div>
        </Row>
      ))
    }
  </main>
  <Footer />
</Base>

<style>
  .sec {
    display: grid;
    gap: 1rem 3rem;
    padding-block: clamp(2rem, 1.5rem + 2vw, 3rem);
  }
  @media (min-width: 768px) {
    .sec {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }
  .sec-body {
    display: grid;
    gap: 1rem;
    max-width: 42rem;
    color: var(--fg-muted);
    line-height: 1.65;
  }
  .sec-body :global(strong) {
    color: var(--fg);
    font-weight: 600;
  }
  .sec-body :global(a) {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
  }
  .sec-body :global(a:hover) {
    text-decoration-color: currentColor;
  }
  .sec-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
  }
</style>
