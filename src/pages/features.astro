---
// The Features page: what every doc type has, in 22 clips grouped by what the reader does (comment, decide, send
// and approve, revise, the home page, theme and width), then how the agent reads the notes, the install row and a
// cell per type. Laid out like a type page (TypePage.astro) from featuresPage in src/content/types.ts; the groups
// alternate between the page and a band.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Row from '../components/Row.astro';
import SectionHead from '../components/SectionHead.astro';
import TypeHero from '../components/TypeHero.astro';
import ClipCard from '../components/ClipCard.astro';
import AgentSnippet from '../components/AgentSnippet.astro';
import Install from '../components/Install.astro';
import TypeLinks from '../components/TypeLinks.astro';
import { featuresPage as page } from '../content/types';
import { inlineCode } from '../lib/inline-code';

// rows 01–02 are the hero and 03 the groups' index, so the groups start at 04; the rows after them follow on
const after = page.groups.length + 4;
---

<Base title={page.metaTitle} description={page.metaDescription}>
  <Nav />
  <main id="main">
    <TypeHero kicker={page.kicker} display={page.display} title={page.title} pitch={page.pitch} hero={page.hero} />

    <Row n="03" plain>
      <nav aria-label={page.groupsLabel}>
        <ul class="index">
          {
            page.groups.map((g) => (
              <li>
                <a class="index-link" href={`#${g.id}`}>
                  <span>{g.kicker}</span>
                  <span class="label whitespace-nowrap">{g.clips.length} clips</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </Row>

    {
      page.groups.map((g, gi) => (
        <Row n={String(gi + 4).padStart(2, '0')} id={g.id} band={gi % 2 === 1} labelledby={`${g.id}-title`} class="scroll-mt-16">
          <SectionHead kicker={g.kicker} title={g.title} titleId={`${g.id}-title`} lead={g.lead} />
          <ul class:list={['clip-grid', { 'clip-grid-3': g.clips.length % 2 === 1 }]}>
            {g.clips.map((item, i) => (
              <ClipCard item={item} index={i % 3} />
            ))}
          </ul>
        </Row>
      ))
    }

    <Row n={String(after).padStart(2, '0')} labelledby="agent-title">
      <SectionHead kicker={page.agentKicker} title={page.agentTitle} titleId="agent-title" leadHtml={inlineCode(page.agent.lead)} />
      <div class="rail-pad row-y pt-0!" data-reveal>
        <AgentSnippet agent={page.agent} />
      </div>
    </Row>

    <Install n={String(after + 1).padStart(2, '0')} />
    <TypeLinks n={String(after + 2).padStart(2, '0')} />
  </main>
  <Footer />
</Base>

<style>
  .index {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
  }
  .index > li {
    border-right: 1px solid var(--rail);
    border-bottom: 1px solid var(--rail);
    margin-bottom: -1px;
  }
  .index-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    height: 3.5rem;
    padding-inline: 1.1rem;
    font-size: 0.9375rem;
    color: var(--fg-muted);
    transition:
      color 0.15s,
      background-color 0.15s;
  }
  .index-link:hover {
    color: var(--fg);
    background: var(--brand-tint);
  }
</style>
