---
// The home page: a floating nav, the night bay behind the headline and the install tabs, the plan hook film, then
// the doc types, setup, the chat-versus-page comparison, what you do on a page, the FAQ and the install band. The
// sections live in src/components/atlas/ and their copy in src/content/atlas.ts. Each doc type has its own page
// ([type].astro), and revisions one of their own (revisions.astro).
import '../styles/atlas.css';
import Base from '../layouts/Base.astro';
import Nav from '../components/atlas/Nav.astro';
import Hero from '../components/atlas/Hero.astro';
import Types from '../components/atlas/Types.astro';
import Setup from '../components/atlas/Setup.astro';
import Compare from '../components/atlas/Compare.astro';
import Answering from '../components/atlas/Answering.astro';
import Faq from '../components/atlas/Faq.astro';
import Cta from '../components/atlas/Cta.astro';
import Footer from '../components/atlas/Footer.astro';
import { atlasMeta } from '../content/atlas';
---

<Base title={atlasMeta.title} description={atlasMeta.description}>
  <Nav />
  <main id="main">
    <Hero />
    <Types />
    <Setup />
    <Compare />
    <Answering />
    <Faq />
    <Cta />
  </main>
  <Footer />
</Base>
