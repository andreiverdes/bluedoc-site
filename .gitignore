# build output
dist/
# generated types
.astro/
# clip recordings' raw frames (clips/run.mjs)
clips/.work/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

